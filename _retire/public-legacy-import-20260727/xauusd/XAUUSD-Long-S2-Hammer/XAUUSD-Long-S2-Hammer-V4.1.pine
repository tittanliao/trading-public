// © Tittan
// Strategy: XAUUSD-Long-S2-Hammer-V4.1（測試版，未確認，需 TradingView Premium/Ultimate）
// Base: V4.0（Footprint 吸收過濾器）
// V4.1 changes vs V4.0（20260712，依據使用者 TV 實測：D 模式 PF 2.05→2.2，其他模式無明顯變化）：
//   ① fp_mode 預設 OFF → 「D. A+C 皆須成立」（TV實測最佳；⚠️ 尚未做逐筆OOS驗證，仍為測試版）
//   ② Footprint 新增三個模式（圍繞已驗證的 D 繼續深化吸收邏輯）：
//      G. D+恐慌爆量 — D 再疊加 Volume Climax（≥N倍均量）：教科書級 selling climax + absorption
//      H. 賣方衰竭（trapped sellers）— 低檔區出現「賣方失衡」但 delta 相對前N根改善：
//         恐慌賣單全數成交在最低點、卻推不動價格 = 賣壓被吃光，賣方被困
//      I. 收回價值區 — close ≥ VAL（Value Area Low）：收盤收回價值區內 = 低價遭市場拒絕
//   ③ 新增 FILTER ⑩: Volume Climax（Gemini 建議採納）：錘頭需伴隨恐慌爆量（volume ≥ N×均量）
//      ⚠️ FX_IDC 為 tick volume（報價筆數）非真實成交量，方向性仍有參考價值
//   ④ 新增 FILTER ⑪: DXY 死亡區間阻擋（Gemini 建議「阻擋強勢DXY」與數據矛盾，改為數據驅動版）：
//      225筆歸因實測 DXY RSI 30-50 才是最差區間（WR 34.6%），RSI>70 反而 44.4%、50-70 有 48.8%
//      → 阻擋 30≤DXY RSI<50 死亡區間，而非阻擋強勢區
//   ⑤ Gemini 的 Micro Bounce（1m array）未採納：與 Footprint C/D 同機制但資料更差——
//      request.security_lower_tf 的 intrabar 歷史深度有限（2年回測只覆蓋最近數月），
//      且 footprint 直接給出每價位買賣量+失衡，資訊嚴格優於 1m close 序列；未來可再評估
// ── V4.0 原始設計說明（順勢/逆勢落差）──
// V4.0 changes vs V3.2：
//   新增 FILTER ③: Footprint 訂單流過濾器（request.footprint()，Premium 限定）
//
//   ⚠️ 關鍵設計差異（使用者要求仔細思考順勢/逆勢落差）：
//   S1-AweWithBB 是右側突破（順勢）——邏輯是「確認買方已經主導」（delta>0、POC上移、買方堆疊）。
//   S2-Hammer 是左側反轉（逆勢，接刀等反彈）——這套邏輯不能直接套用！錘頭進場的當下，
//   賣壓還沒真正結束，若要求「delta必須為正」等於要等趨勢已經反轉才進場，違背左側交易的本質。
//   S2-Hammer 真正該問的問題是「這次下殺的賣壓，有沒有被買方吸收（absorption/exhaustion）」，
//   而不是「買方是否已經主導」。因此 V4.0 的 Footprint 模式改為吸收/衰竭邏輯：
//     A. POC上半部（下影線遭拒）— 儘管有長下影線，大部分成交量集中在K棒上半部，
//        代表最低點的賣壓沒有被市場「接受」（auction rejection），非隨機下影線
//     B. Delta衰竭轉強 — 本根 delta佔比 相較 前N根平均delta佔比 有改善（即使本根仍是負值），
//        代表賣壓正在減弱，不要求「已經轉正」（那是S1的順勢邏輯，不適用於左側反轉）
//     C. 低檔買方吸收堆疊 — 連續≥N個相鄰價位列在K棒下半部區間出現買方失衡，
//        代表買方在最低點附近主動進場吸收拋壓（跟S1的C同機制，但只看K棒下半部的列）
//     D. A+C 皆須成立（嚴格：下影線被拒 + 低檔真的有買方進場吸收）
//     E. A或B 任一成立（寬鬆）
//     F. 排除真賣壓阻擋 — 只阻擋「delta仍明顯惡化 且 POC仍在低檔」的明確空頭延續情況，
//        其餘一律放行（最保守，最小誤殺）
//   其餘 filter 順序下移：④提早保本 ⑤時間市價 ⑥Regime ⑦Z-Score ⑧趨勢EMA ⑨洞察濾網
//   ⚠️ Footprint 預設 OFF；歷史K棒可能無 footprint 資料（回傳na），預設「na=通過」避免誤殺，
//     狀態表格顯示資料覆蓋率，若覆蓋率過低則此過濾器回測結論不可信
//   ⚠️ API 依據 20260711 官方 blog/release notes：每個腳本僅允許一次 request.footprint() 呼叫
// Entry: S2_LE  Exit: S2_LX_TP1 / S2_LX_TP2 / S2_SL / S2_BE / S2_LX_TimeWin / S2_LX_TimeLoss
//@version=6
strategy(title="XAUUSD-Long-S2-Hammer-V4.1",
 shorttitle="S2-Hammer-V4.1",
 overlay = true,
 format=format.price,
 precision=2,
 default_qty_type=strategy.cash, initial_capital=10000,
 default_qty_value=10000, commission_value=0.00,
 slippage=1)

//------------------------------------------------------------------------------
// 1. 前置設定與輸入 (Inputs)
//------------------------------------------------------------------------------
strategy.cancel_all()
MP = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

// --- 風險管理 ---
grp_risk = "=== 風險與出場 (Risk & Exit) ==="
sl_fix_pct = input.float(1.0, title="固定止損 % (Fixed SL)", step=0.1, group=grp_risk)
Profit_Ratio_1 = input.float(2.0, title="TP1 盈虧比 (Ratio)", step=0.1, group=grp_risk)
Profit_Ratio_2 = input.float(4.0, title="TP2 盈虧比 (Ratio)", step=0.1, group=grp_risk, tooltip="4R 已驗證優於 2R（讓贏家跑），視為定論。⚠️ 20260711：提早保本已證實會腰斬這類慢贏單，不建議搭配使用")
out_k_count = input.int(48, "時間出場 (K棒數)", group=grp_risk, tooltip="⚠️ 20260711 歸因：90% 贏單持倉 ≥12h，不要調小；提早保本已證實無效（見FILTER④），time_bleed 可能是「讓贏家跑」的結構性代價")

// --- S2 核心：錘頭線定義 ---
grp_core = "=== S2 核心: 錘頭線設定 (Core) ==="
hammer_tail_ratio = input.float(2.0, "下影線/實體 比例", minval=1.0, step=0.1, group=grp_core)
hammer_upper_ratio = input.float(0.5, "上影線/實體 比例", maxval=1.0, step=0.1, group=grp_core)
min_body_atr_mult = input.float(0.3, "最小 K 棒波動濾網 (ATR Mult)", minval=0.0, group=grp_core)

// --- FILTER ①: HTF RSI 過濾器（V2.2，預設 ON）---
grp_htf = "=== FILTER ①: HTF RSI 過濾器（預設 ON）==="
use_htf_filter = input.bool(true, "啟用 HTF RSI 過濾器", group=grp_htf, tooltip="公式：bearish = RSI@時框 < SMA(RSI)@時框 且 SMA(RSI) 較前一根下降\nbearish 時阻擋進場\n\n為何需要：MTF 分析——高時框 bearish 時 S2-Hammer 勝率僅 ~33%（vs bullish ~52%），且 time_bleed（持倉24h無方向）比例大幅升高；逆大週期接刀撐太久才被掃出")
htf_tf = input.timeframe("60", "HTF 判定時框", group=grp_htf)
htf_rsi_len = input.int(14, "HTF RSI 週期", minval=5, group=grp_htf)
htf_rsi_ma_len = input.int(14, "HTF RSI-MA 週期", minval=3, group=grp_htf)

// --- FILTER ②: S2-RSI 互斥（V2.4.1，預設 ON）---
grp_mutex = "=== FILTER ②: S2-RSI 互斥（預設 ON）==="
use_mutex_filter = input.bool(true, "啟用 S2-RSI 互斥過濾器", group=grp_mutex, tooltip="公式：RSI(N) 上穿門檻後 barssince ≤ 回看K棒數 → 阻擋錘頭進場\n\n為何需要：20260711 真實逐筆歸因——錘頭與 S2-RSI 訊號『合流』時 WR 30.8%/PF 1.03（接刀），錘頭『單獨』出現時 WR 50.4%/PF 2.14。兩策略同時觸發代表市場仍在下跌加速段，錘頭型態失效。\n\n注意：統計檢驗用對稱 ±12h，實盤只能回看（單向近似），以 TV 回測為準")
mutex_rsi_len = input.int(14, "互斥判定 RSI 週期", minval=1, group=grp_mutex)
mutex_rsi_limit = input.int(20, "互斥判定 RSI 門檻（上穿=S2-RSI環境）", minval=10, maxval=50, group=grp_mutex)
mutex_bars = input.int(24, "互斥回看 K 棒數", minval=1, group=grp_mutex, tooltip="30m 圖上 24 根 = 12 小時")

// --- FILTER ③: Footprint 訂單流吸收過濾器（V4.0 新增，Premium）---
grp_fp = "=== FILTER ③: Footprint 賣壓吸收（V4.0 新增，Premium）==="
fp_mode = input.string("D. A+C 皆須成立", "Footprint 模式", options=["OFF", "A. POC上半部（下影線遭拒）", "B. Delta衰竭轉強", "C. 低檔買方吸收堆疊≥N", "D. A+C 皆須成立", "E. A或B 任一成立", "F. 排除真賣壓阻擋", "G. D+恐慌爆量", "H. 賣方衰竭（trapped sellers）", "I. 收回價值區（close≥VAL）"], group=grp_fp,
 tooltip="⚠️ 逆勢反轉專用邏輯，跟順勢突破（S1）的「delta必須為正」不同！錘頭進場當下賣壓還沒真正結束，\n真正該確認的是『下殺有沒有被買方吸收』，不是『買方是否已主導』：\n\nA. POC上半部：POC位置=(POC中價−low)/(high−low)≥門檻%。儘管有長下影線，成交量集中在上半部\n=最低點的賣壓沒被市場接受（auction rejection），這是最低點『非隨機』的直接證據\n\nB. Delta衰竭轉強：本根delta佔比 − 前N根平均delta佔比 ≥ 改善門檻pp。不要求轉正，只要求賣壓\n『正在減弱』——這才是左側反轉該問的問題，不是右側突破的『買方已主導』\n\nC. 低檔買方吸收堆疊：連續≥N個相鄰價位列（僅看K棒下半部區間）出現買方失衡，代表買方在\n最低點附近主動進場吸收拋壓，是機構『撿便宜』的足跡\n\nD/E：組合模式（D嚴格=A且C；E寬鬆=A或B）\n\nF. 排除真賣壓阻擋：只阻擋『delta仍明顯惡化 且 POC仍在低檔』的明確空頭延續情況，其餘放行\n——最保守，最小誤殺\n\nG. D+恐慌爆量（V4.1）：D 再疊加 volume ≥ N×均量（參數共用 FILTER ⑩）——教科書級 selling climax + absorption，恐慌拋售被全部吃下\n\nH. 賣方衰竭 trapped sellers（V4.1）：低檔區出現『賣方失衡』（恐慌賣單成交在最低點）但 delta 相對前N根改善（推不動價格）= 賣壓被吃光、賣方被困\n\nI. 收回價值區（V4.1）：close ≥ VAL（Value Area Low 中價）——收盤收回價值區內，低價遭市場拒絕\n\n⚠️ 20260711 TV實測：D 模式 PF 2.05→2.2（其他模式無明顯變化），V4.1 起 D 為預設\n⚠️ 需 Premium/Ultimate；歷史K棒可能無資料（見na處理）")
fp_ticks_per_row = input.int(250, "每列 tick 數（ticks_per_row）", minval=1, group=grp_fp,
 tooltip="每個價位列的高度（tick數，1 tick = syminfo.mintick）。建議調到每根30m K棒約10~30列。若編譯報錯要求常數，把此input改為程式碼寫死")
fp_va_percent = input.int(70, "Value Area %", minval=50, maxval=95, group=grp_fp)
fp_imbalance_pct = input.int(300, "失衡判定門檻 %（imbalance_percent）", minval=100, group=grp_fp)
fp_poc_min_pos = input.float(55.0, "A: POC 最低位置 %（0=低點,100=高點）", step=5.0, group=grp_fp, tooltip="錘頭下影線本來就在下半部，POC門檻建議略高於50%才有鑑別力")
fp_delta_lookback = input.int(5, "B: Delta 歷史比較根數", minval=2, group=grp_fp)
fp_delta_improve_pp = input.float(5.0, "B: Delta 改善門檻（百分點）", step=1.0, group=grp_fp, tooltip="本根delta佔比 − 前N根平均delta佔比 需 ≥ 此值，代表賣壓相對減弱")
fp_stack_n = input.int(2, "C: 低檔買方堆疊 最少連續列數", minval=2, group=grp_fp)
fp_lower_zone_pct = input.float(50.0, "C: 「低檔」範圍定義（%，由low往上算）", minval=20.0, maxval=80.0, step=5.0, group=grp_fp)
fp_block_delta_thresh = input.float(-15.0, "F: 明確賣壓 delta門檻（%以下才阻擋）", step=5.0, group=grp_fp)
fp_na_pass = input.bool(true, "無 footprint 資料時視為通過", group=grp_fp,
 tooltip="歷史K棒可能沒有footprint資料（request.footprint()回傳na）。\n開（預設）= na視為通過，避免資料缺口誤殺訊號\n關 = na一律阻擋（僅適合確認資料覆蓋率極高後使用）\n狀態表格會顯示資料覆蓋率——覆蓋率低時此過濾器的回測結論不可信")

// --- FILTER ④: 提早保本（V2.4.1 出場增強，⚠️ 20260711已證實無效）---
grp_be = "=== FILTER ④: 提早保本（⚠️ 20260711已證實無效）==="
use_early_be = input.bool(false, "啟用提早保本", group=grp_be, tooltip="公式：high 曾達 Entry×(1+觸發%) → SL 上移至 Entry×(1+偏移%)，出場標記 S2_BE\n\n⚠️ 20260711 保本參數掃描（真實K棒逐bar重建，非僅MFE彙總粗估）：測試0.10%~1.75%共12個門檻，在V1.9全樣本/V3.2全樣本/V1.9-OOS段全部呈現淨損，最佳門檻也只接近打平（不是真的優勢）。原因：多數贏單是慢贏（持倉90h+），過程常見先小賺拉回進場價、之後才反轉大漲，保本會把這類單提前腰斬在打平，砍贏家的代價>救輸家的好處，門檻越低代價越大。不建議開啟，詳見 report_early_be_sweep.html")
be_trigger_pct = input.float(0.3, "保本觸發浮盈 %", step=0.05, minval=0.1, group=grp_be)
be_offset_pct = input.float(0.0, "保本位置偏移 %（0=進場價）", step=0.05, group=grp_be)

// --- FILTER ⑤: 時間止損市價修正（V2.2 出場增強）---
grp_timefix = "=== FILTER ⑤: 時間止損市價修正（V2.2 出場增強）==="
use_time_close_fix = input.bool(false, "啟用時間止損 strategy.close() 修正", group=grp_timefix, tooltip="公式：持倉 ≥ 時間出場K棒數 → strategy.close() 下一根開盤市價平倉\n\n為何需要：V1.9 原始邏輯用 stop=low 掛停損單，若價格跳空或快速下跌可能不成交，時間止損不保證執行；V2.2 改用 strategy.close() 保證平倉。\n\n關閉 = V1.9 原始 stop 掛單邏輯")

// --- FILTER ⑥: Regime 過濾器（V2.3）---
grp_regime = "=== FILTER ⑥: Regime 過濾器（V2.3）==="
use_regime_filter = input.bool(false, "啟用 Regime 過濾器", group=grp_regime, tooltip="公式：\nBBW = stdev(close,BB週期)×4 / sma(close,BB週期)\nbbw_rank = percentrank(BBW, rank回看)\nslope = (EMA(斜率EMA週期) − EMA[斜率回看根數前]) / EMA前值 × 100%\nCONSOLIDATION = bbw_rank < BBW門檻 且 |slope| < 斜率門檻\n\n為何需要：2026 H1 188 筆真實交易歸因——CONSOLIDATION（低波動+中性斜率）環境下 S2 期望值 -0.98R，錘頭在盤整區反覆止損。開啟後阻擋此環境進場")
regime_tf = input.timeframe("240", "Regime 判定時框", group=grp_regime)
regime_slope_ema_len = input.int(20, "斜率 EMA 週期", minval=5, group=grp_regime)
regime_slope_lookback = input.int(10, "斜率回看根數", minval=1, group=grp_regime)
regime_slope_thresh = input.float(0.15, "EMA 斜率門檻（%）", step=0.05, group=grp_regime)
regime_bb_len = input.int(20, "BBW 計算 BB 週期", minval=5, group=grp_regime)
regime_bbw_rank_len = input.int(60, "BBW percentrank 回看根數", minval=20, group=grp_regime)
regime_bbw_high = input.float(65.0, "BBW rank 門檻（%）", step=5.0, group=grp_regime, tooltip="bbw_rank < 此值 且 |slope| < 斜率門檻 = CONSOLIDATION")

// --- FILTER ⑦: Z-Score 過濾器（V2.3）---
grp_zscore = "=== FILTER ⑦: Z-Score 過濾器（V2.3）==="
use_zscore_filter = input.bool(false, "啟用 Z-Score 過濾器", group=grp_zscore, tooltip="公式：Z = (close − EMA(週期)@時框) / ATR(週期)@時框\nZ < 陷阱門檻 → 阻擋進場\n\n⚠️ 20260711 歸因：本過濾器效果已被 FILTER ② 互斥涵蓋，疊加無增益，不建議同開")
use_zscore_strict = input.bool(false, "嚴格模式：僅允許甜蜜區進場", group=grp_zscore, tooltip="⚠️ 甜蜜區結論已被大樣本歸因推翻，僅供研究對照")
z_tf = input.timeframe("240", "Z-Score 判定時框", group=grp_zscore)
z_ema_len = input.int(20, "Z-Score EMA 週期", minval=5, group=grp_zscore)
z_atr_len = input.int(14, "Z-Score ATR 週期", minval=5, group=grp_zscore)
z_trap_thresh = input.float(-2.5, "陷阱門檻（Z < 此值阻擋）", step=0.1, group=grp_zscore)
zscore_low = input.float(-1.5, "甜蜜區下限（嚴格模式）", step=0.1, group=grp_zscore)
zscore_high = input.float(-0.5, "甜蜜區上限（嚴格模式）", step=0.1, group=grp_zscore)

// --- FILTER ⑧: 趨勢 EMA 過濾器（V2.1）---
grp_trend = "=== FILTER ⑧: 趨勢 EMA 過濾器（V2.1）==="
use_trend_filter = input.bool(false, "啟用趨勢 EMA 過濾器", group=grp_trend, tooltip="公式：close > EMA(週期)@時框 才允許進場\n\n為何需要：確認價格在上升結構中，錘頭才是有效回彈；避免在橫盤或下跌結構中出現的假錘子")
trend_tf = input.timeframe("240", "趨勢 EMA 時框", group=grp_trend)
trend_len = input.int(200, "趨勢 EMA 週期", minval=50, group=grp_trend)

// --- FILTER ⑨: 洞察濾網 DXY + RSI 情境（V2.0）---
grp_insight = "=== FILTER ⑨: 洞察濾網 DXY+RSI情境（V2.0）==="
use_insight = input.bool(false, "啟用洞察濾網", group=grp_insight, tooltip="公式：DXY RSI(週期)@時框 < 門檻 且 RSI情境下限 ≤ 本圖 RSI(週期) ≤ RSI情境上限\n\n目的：減少 time_bleed（持倉超過24h無方向）比例")
dxy_sym = input.symbol("TVC:DXY", "DXY 代碼", group=grp_insight)
dxy_tf = input.timeframe("D", "DXY RSI 時框", group=grp_insight)
dxy_rsi_len = input.int(14, "DXY RSI 週期", minval=5, group=grp_insight)
dxy_rsi_thresh = input.int(50, "DXY RSI 門檻 (< 此值才進場)", minval=20, maxval=80, group=grp_insight)
rsi_ctx_len = input.int(14, "RSI 情境 週期", minval=5, group=grp_insight)
rsi_ctx_low = input.int(25, "RSI 情境 下限 (≥ 此值才進場)", minval=10, maxval=40, group=grp_insight)
rsi_ctx_high = input.int(55, "RSI 情境 上限 (≤ 此值才進場)", minval=40, maxval=70, group=grp_insight)

// --- FILTER ⑩: Volume Climax 恐慌爆量（V4.1 新增，Gemini 建議採納）---
grp_climax = "=== FILTER ⑩: Volume Climax 恐慌爆量（V4.1）==="
use_vol_climax = input.bool(false, "啟用 Volume Climax 過濾器", group=grp_climax, tooltip="公式：volume ≥ 倍數 × SMA(volume, 均量週期) 才允許進場\n\n為何需要：有效的錘頭反轉通常伴隨恐慌性爆量（selling climax）——大量恐慌賣單在低點被一次吃光，賣壓才算真正宣洩完畢；縮量的錘頭下影線往往只是流動性稀薄造成的隨機刺針\n\n⚠️ FX_IDC 為 tick volume（報價筆數）非真實成交量，方向性仍有參考價值\n⚠️ 此參數同時被 Footprint 模式 G 共用（G = D + 本條件，不需要開啟本開關）")
vol_climax_mult = input.float(2.0, "爆量倍數（×均量）", minval=1.0, step=0.25, group=grp_climax)
vol_climax_len = input.int(20, "均量計算週期", minval=5, group=grp_climax)

// --- FILTER ⑪: DXY 死亡區間阻擋（V4.1 新增，數據驅動版）---
grp_dxyband = "=== FILTER ⑪: DXY 死亡區間阻擋（V4.1）==="
use_dxy_band = input.bool(false, "啟用 DXY 死亡區間阻擋", group=grp_dxyband, tooltip="公式：區間下限 ≤ DXY RSI(日線) < 區間上限 → 阻擋進場（RSI 參數共用 FILTER ⑨ 的 DXY 設定）\n\n為何需要：Gemini 建議『DXY 強勢主升段阻擋接刀』，但 225 筆真實歸因數據相反——\nDXY RSI 30-50（美元弱而未死）才是最差區間：WR 僅 34.6%；\nDXY RSI >70（強勢）反而 44.4%、50-70 有 48.8%、<30 最佳 66.7%。\n機制推測：美元溫和走弱時黃金漲勢緩慢無方向（最容易 time_bleed），美元極強時黃金超跌反彈反而乾脆。\n因此本過濾器阻擋的是數據上的死亡區間 30-50，不是直覺上的強勢區")
dxy_band_low = input.float(30.0, "死亡區間下限（DXY RSI ≥）", step=5.0, group=grp_dxyband)
dxy_band_high = input.float(50.0, "死亡區間上限（DXY RSI <）", step=5.0, group=grp_dxyband)

// --- 顯示設定 ---
grp_display = "=== 顯示設定 ==="
show_status_table = input.bool(false, "顯示過濾器狀態表格（右上角）", group=grp_display)
show_filtered_hammers = input.bool(true, "標示被過濾掉的錘頭（灰色 H）", group=grp_display)
show_inpos_hammers = input.bool(true, "標示持倉中出現的錘頭（綠色 S2）", group=grp_display, tooltip="已持倉時出現新錘頭訊號，以綠色 tiny 三角提醒（不會進場，僅提示）")

// --- 統計面板 ---
grp_stat = "=== 統計面板設定 ==="
show_table = input.bool(false, title="顯示統計表格", group=grp_stat)
show_detail_stats = input.bool(true, title="顯示詳細時段統計", group=grp_stat)

//------------------------------------------------------------------------------
// 2. 指標運算 (Indicators)
//------------------------------------------------------------------------------
atr_val = ta.atr(14)

// K線特徵（錘頭三條件拆成獨立變數，避免多行 and 接續）
body_top = math.max(close, open)
body_btm = math.min(close, open)
body_size = body_top - body_btm
lower_shadow = body_btm - low
upper_shadow = high - body_top
total_range = high - low

hammer_c1 = lower_shadow > body_size * hammer_tail_ratio
hammer_c2 = upper_shadow < body_size * hammer_upper_ratio
hammer_c3 = total_range > atr_val * min_body_atr_mult
is_hammer = hammer_c1 and hammer_c2 and hammer_c3

// FILTER ①: HTF RSI 狀態
htf_rsi_val = request.security(syminfo.tickerid, htf_tf, ta.rsi(close, htf_rsi_len), lookahead=barmerge.lookahead_off)
htf_rsi_ma = request.security(syminfo.tickerid, htf_tf, ta.sma(ta.rsi(close, htf_rsi_len), htf_rsi_ma_len), lookahead=barmerge.lookahead_off)
htf_rsi_ma_prev = request.security(syminfo.tickerid, htf_tf, ta.sma(ta.rsi(close, htf_rsi_len), htf_rsi_ma_len)[1], lookahead=barmerge.lookahead_off)
htf_is_bearish = htf_rsi_val < htf_rsi_ma and htf_rsi_ma < htf_rsi_ma_prev

// FILTER ②: S2-RSI 互斥環境判定
mutex_rsi_val = ta.rsi(close, mutex_rsi_len)
rsi_env_signal = ta.crossover(mutex_rsi_val, mutex_rsi_limit)
bars_since_rsi = ta.barssince(rsi_env_signal)
is_rsi_env = not na(bars_since_rsi) and bars_since_rsi <= mutex_bars

// FILTER ③: Footprint（每腳本僅允許一次 request.footprint() 呼叫）
footprint fp = request.footprint(fp_ticks_per_row, fp_va_percent, fp_imbalance_pct)

bool fp_data_ok = not na(fp)
float fp_delta = na
float fp_total = na
float fp_delta_ratio = na
float fp_poc_pos = na
float fp_val_mid = na
int fp_max_buy_stack_low = 0
bool fp_bottom_sell_imb = false
float fp_lower_zone_top = low + total_range * fp_lower_zone_pct / 100

if fp_data_ok
    fp_delta := fp.delta()
    fp_total := fp.buy_volume() + fp.sell_volume()
    fp_delta_ratio := fp_total > 0 ? fp_delta / fp_total * 100 : 0.0
    volume_row pocRow = fp.poc()
    float poc_mid = (pocRow.up_price() + pocRow.down_price()) / 2
    fp_poc_pos := high == low ? 50.0 : (poc_mid - low) / (high - low) * 100
    volume_row valRow = fp.val()
    fp_val_mid := (valRow.up_price() + valRow.down_price()) / 2
    array<volume_row> fp_rows = fp.rows()
    int streak = 0
    for r in fp_rows
        float r_mid = (r.up_price() + r.down_price()) / 2
        if r_mid <= fp_lower_zone_top and r.has_buy_imbalance()
            streak += 1
            fp_max_buy_stack_low := math.max(fp_max_buy_stack_low, streak)
        else
            streak := 0
        if r_mid <= fp_lower_zone_top and r.has_sell_imbalance()
            fp_bottom_sell_imb := true

// FILTER ③ B: Delta 歷史比較（手動維護滾動陣列，避開 na 傳播問題）
var array<float> fp_delta_hist = array.new_float()
float fp_delta_avg_prior = na
if fp_data_ok
    if array.size(fp_delta_hist) > 0
        fp_delta_avg_prior := array.avg(fp_delta_hist)
    array.push(fp_delta_hist, fp_delta_ratio)
    if array.size(fp_delta_hist) > fp_delta_lookback
        array.shift(fp_delta_hist)

// footprint 覆蓋率統計（顯示於狀態表格）
var int fp_bars_total = 0
var int fp_bars_with_data = 0
fp_bars_total += 1
if fp_data_ok
    fp_bars_with_data += 1

// FILTER ⑩: Volume Climax（獨立過濾器；Footprint 模式 G 共用此計算）
vol_sma_val = ta.sma(volume, vol_climax_len)
is_vol_climax = vol_sma_val > 0 and volume >= vol_sma_val * vol_climax_mult

// FILTER ③ 各模式條件
fp_cond_A = fp_data_ok and fp_poc_pos >= fp_poc_min_pos
fp_cond_B = fp_data_ok and not na(fp_delta_avg_prior) and (fp_delta_ratio - fp_delta_avg_prior) >= fp_delta_improve_pp
fp_cond_C = fp_data_ok and fp_max_buy_stack_low >= fp_stack_n
fp_cond_F_block = fp_data_ok and fp_delta_ratio <= fp_block_delta_thresh and fp_poc_pos < fp_poc_min_pos
fp_cond_G = fp_cond_A and fp_cond_C and is_vol_climax
fp_cond_H = fp_data_ok and fp_bottom_sell_imb and fp_cond_B
fp_cond_I = fp_data_ok and not na(fp_val_mid) and close >= fp_val_mid

bool fp_raw_ok = true
if fp_mode == "A. POC上半部（下影線遭拒）"
    fp_raw_ok := fp_cond_A
else if fp_mode == "B. Delta衰竭轉強"
    fp_raw_ok := fp_cond_B
else if fp_mode == "C. 低檔買方吸收堆疊≥N"
    fp_raw_ok := fp_cond_C
else if fp_mode == "D. A+C 皆須成立"
    fp_raw_ok := fp_cond_A and fp_cond_C
else if fp_mode == "E. A或B 任一成立"
    fp_raw_ok := fp_cond_A or fp_cond_B
else if fp_mode == "F. 排除真賣壓阻擋"
    fp_raw_ok := not fp_cond_F_block
else if fp_mode == "G. D+恐慌爆量"
    fp_raw_ok := fp_cond_G
else if fp_mode == "H. 賣方衰竭（trapped sellers）"
    fp_raw_ok := fp_cond_H
else if fp_mode == "I. 收回價值區（close≥VAL）"
    fp_raw_ok := fp_cond_I

fp_ok = fp_mode == "OFF" or (not fp_data_ok ? fp_na_pass : fp_raw_ok)

// FILTER ⑥: Regime 指標
regime_ema_now = request.security(syminfo.tickerid, regime_tf, ta.ema(close, regime_slope_ema_len), lookahead=barmerge.lookahead_off)
regime_ema_pre = request.security(syminfo.tickerid, regime_tf, ta.ema(close, regime_slope_ema_len)[regime_slope_lookback], lookahead=barmerge.lookahead_off)
regime_slope = na(regime_ema_pre) or regime_ema_pre == 0 ? 0.0 : (regime_ema_now - regime_ema_pre) / regime_ema_pre * 100
regime_bbw_rank = request.security(syminfo.tickerid, regime_tf, ta.percentrank(ta.stdev(close, regime_bb_len) * 4 / ta.sma(close, regime_bb_len), regime_bbw_rank_len), lookahead=barmerge.lookahead_off)
is_consolidation = regime_bbw_rank < regime_bbw_high and math.abs(regime_slope) < regime_slope_thresh

// FILTER ⑦: Z-Score 指標
z_ema_val = request.security(syminfo.tickerid, z_tf, ta.ema(close, z_ema_len), lookahead=barmerge.lookahead_off)
z_atr_val = request.security(syminfo.tickerid, z_tf, ta.atr(z_atr_len), lookahead=barmerge.lookahead_off)
z_score = na(z_atr_val) or z_atr_val == 0 ? 0.0 : (close - z_ema_val) / z_atr_val
is_zscore_trap = z_score < z_trap_thresh
z_in_sweet = z_score >= zscore_low and z_score <= zscore_high

// FILTER ⑧: 趨勢 EMA
trend_ema = request.security(syminfo.tickerid, trend_tf, ta.ema(close, trend_len), lookahead=barmerge.lookahead_off)

// FILTER ⑨: DXY RSI + RSI 情境
dxy_rsi_val = request.security(dxy_sym, dxy_tf, ta.rsi(close, dxy_rsi_len), lookahead=barmerge.lookahead_off)
rsi_ctx_val = ta.rsi(close, rsi_ctx_len)
rsi_ctx_ok = rsi_ctx_val >= rsi_ctx_low and rsi_ctx_val <= rsi_ctx_high

// 過濾條件（全部拆獨立變數；OFF = 恆為 true）
htf_ok = not use_htf_filter or not htf_is_bearish
mutex_ok = not use_mutex_filter or not is_rsi_env
regime_ok = not use_regime_filter or not is_consolidation
z_strict_ok = not use_zscore_strict or z_in_sweet
zscore_ok = not use_zscore_filter or (not is_zscore_trap and z_strict_ok)
trend_ok = not use_trend_filter or close > trend_ema
insight_ok = not use_insight or (dxy_rsi_val < dxy_rsi_thresh and rsi_ctx_ok)
vol_climax_ok = not use_vol_climax or is_vol_climax
in_dxy_dead_band = dxy_rsi_val >= dxy_band_low and dxy_rsi_val < dxy_band_high
dxy_band_ok = not use_dxy_band or not in_dxy_dead_band

//------------------------------------------------------------------------------
// 3. 進場邏輯 (Entry Logic)
//------------------------------------------------------------------------------
MaxUseBars = 50
var LongEntry = false

filters_ok = htf_ok and mutex_ok and fp_ok and regime_ok and zscore_ok and trend_ok and insight_ok and vol_climax_ok and dxy_band_ok
LongCondition = is_hammer and filters_ok

LongEntry := bar_index > MaxUseBars and MP == 0 and LongCondition

if LongEntry
    strategy.entry("S2_LE", strategy.long, comment="S2_LE")

//------------------------------------------------------------------------------
// 4. 出場邏輯 (Profit Flyer + FILTER ④⑤ 出場增強)
//------------------------------------------------------------------------------
EntryPrice = strategy.opentrades.entry_price(strategy.opentrades - 1)
BarsSinceEntry = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)

// --- 固定止損計算 ---
SLPrice = EntryPrice * (1 - sl_fix_pct / 100)
BEPrice = EntryPrice * (1 + be_offset_pct / 100)
PTPrice1 = EntryPrice * (1 + (sl_fix_pct / 100 * Profit_Ratio_1))
PTPrice2 = EntryPrice * (1 + (sl_fix_pct / 100 * Profit_Ratio_2))

// FILTER ④: 保本武裝狀態（浮盈曾達觸發值即鎖定，直到平倉）
var bool be_armed = false
if MP == 0
    be_armed := false
if MP > 0 and use_early_be and high >= EntryPrice * (1 + be_trigger_pct / 100)
    be_armed := true

var float exit_stop_price = na

if MP > 0
    time_up = BarsSinceEntry >= out_k_count
    if use_time_close_fix and time_up
        // FILTER ⑤ ON：strategy.close() 保證下一根開盤市價平倉
        strategy.close("S2_LE", comment=strategy.openprofit >= 0 ? "S2_LX_TimeWin" : "S2_LX_TimeLoss")
    else
        if close >= PTPrice2
            exit_stop_price := math.max(PTPrice2, ta.lowest(low, out_k_count/4))
            strategy.exit("S2_Exit_TP2", from_entry="S2_LE", stop=exit_stop_price, comment="S2_LX_TP2")
        else if close >= PTPrice1
            exit_stop_price := math.max(PTPrice1, ta.lowest(low, out_k_count/2))
            strategy.exit("S2_Exit_TP1", from_entry="S2_LE", stop=exit_stop_price, comment="S2_LX_TP1")
        else if be_armed
            strategy.exit("S2_Exit_BE", from_entry="S2_LE", stop=math.max(SLPrice, BEPrice), comment="S2_BE")
        else
            strategy.exit("S2_Exit_SL", from_entry="S2_LE", stop=SLPrice, comment_loss="S2_SL")

        // FILTER ⑤ OFF：V1.9 原始時間出場（stop 掛單）
        if not use_time_close_fix and time_up
            if strategy.openprofit >= 0
                exit_stop_price := math.max(SLPrice, ta.lowest(low, out_k_count))
                strategy.exit("S2_Exit_TimeWin", from_entry="S2_LE", stop=exit_stop_price, comment="S2_LX_TimeWin")
            else
                exit_stop_price := low
                strategy.exit("S2_Exit_TimeLoss", from_entry="S2_LE", stop=exit_stop_price, comment="S2_LX_TimeLoss")

// Alert
alertcondition(LongEntry, title="S2 Entry", message="S2 Hammer Detected, Price={{close}}")

//------------------------------------------------------------------------------
// 5. 視覺化 (Visualization)
//------------------------------------------------------------------------------
plot(use_trend_filter ? trend_ema : na, title="Trend EMA", color=color.new(color.purple, 0), linewidth=1)

bgcolor(use_mutex_filter and is_rsi_env ? color.new(color.red, 90) : na, title="Mutex: S2-RSI Env")
bgcolor(use_insight and dxy_rsi_val < dxy_rsi_thresh ? color.new(color.green, 95) : na, title="DXY Favorable")
bgcolor(use_htf_filter and htf_is_bearish ? color.new(color.red, 97) : na, title="HTF Bearish Zone")
bgcolor(use_regime_filter and is_consolidation ? color.new(color.gray, 88) : na, title="Regime: CONSOLIDATION")
bgcolor(use_zscore_filter and is_zscore_trap ? color.new(color.red, 92) : na, title="Z-Score Trap")
bgcolor(fp_mode != "OFF" and fp_data_ok and not fp_raw_ok ? color.new(color.aqua, 92) : na, title="Footprint Block")

// 空手時被過濾掉的錘頭（灰色 H）
plotshape(show_filtered_hammers and is_hammer and not LongEntry and bar_index > MaxUseBars and MP == 0, title="Hammer (Filtered)", style=shape.triangleup, location=location.belowbar, color=color.new(color.gray, 60), size=size.tiny, text="H")
// 持倉中出現的錘頭（綠色 tiny S2，僅提示不進場）
plotshape(show_inpos_hammers and is_hammer and MP > 0, title="Hammer (In Position)", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, text="S2")
// 實際進場訊號
plotshape(LongEntry, title="Hammer Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="S2")

// 進場 Label：只顯示四個點位（不附加 filter 狀態文字）
if strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    yPos = high * 1.003
    txt = "LE: " + str.tostring(EntryPrice, "#.##") + "\nSL: " + str.tostring(SLPrice, "#.##") + "\nTP1: " + str.tostring(PTPrice1, "#.##") + "\nTP2: " + str.tostring(PTPrice2, "#.##")
    label.new(bar_index, yPos, text=txt, style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)

// 過濾器狀態表格（右上角）
var table rtbl = table.new(position.top_right, 2, 12, border_width=1, frame_color=color.gray, frame_width=1)

if show_status_table and barstate.islast
    c_on = color.new(color.teal, 60)
    c_off = color.new(color.gray, 70)
    c_block = color.new(color.red, 40)
    c_pass = color.new(color.teal, 40)
    c_hdr = color.new(color.gray, 80)

    h_txt = not use_htf_filter ? "OFF" : htf_is_bearish ? "✗ Bear" : "✓ OK"
    h_bg = not use_htf_filter ? c_off : htf_is_bearish ? c_block : c_pass
    m_txt = not use_mutex_filter ? "OFF" : is_rsi_env ? "✗ 阻擋中" : "✓ 可進場"
    m_bg = not use_mutex_filter ? c_off : is_rsi_env ? c_block : c_pass
    fp_cov = fp_bars_total > 0 ? fp_bars_with_data * 100.0 / fp_bars_total : 0.0
    fp_val_txt = fp_data_ok ? ("Δ" + str.tostring(fp_delta_ratio, "#.#") + "% POC" + str.tostring(fp_poc_pos, "#") + "%") : "NA"
    fp_st_txt = fp_mode == "OFF" ? "OFF" : (not fp_data_ok ? (fp_na_pass ? "NA→PASS" : "NA→BLOCK") : (fp_raw_ok ? "PASS" : "BLOCK"))
    fp_st_bg = fp_mode == "OFF" ? c_off : (not fp_data_ok ? color.new(color.orange,60) : (fp_raw_ok ? c_pass : c_block))
    be_txt = use_early_be ? "+" + str.tostring(be_trigger_pct, "#.##") + "% 觸發" : "OFF"
    tf_txt = use_time_close_fix ? "ON 市價平倉" : "OFF（V1.9 stop）"
    r_txt = not use_regime_filter ? "OFF" : is_consolidation ? "✗ CONSOL" : "✓ OK"
    r_bg = not use_regime_filter ? c_off : is_consolidation ? c_block : c_pass
    z_txt = not use_zscore_filter ? "OFF" : is_zscore_trap ? "✗ TRAP" : "✓ " + str.tostring(z_score, "#.##")
    z_bg = not use_zscore_filter ? c_off : is_zscore_trap ? c_block : c_pass
    t_txt = not use_trend_filter ? "OFF" : close > trend_ema ? "✓ 上方" : "✗ 下方"
    t_bg = not use_trend_filter ? c_off : close > trend_ema ? c_pass : c_block
    i_ok = dxy_rsi_val < dxy_rsi_thresh and rsi_ctx_ok
    i_txt = not use_insight ? "OFF" : i_ok ? "✓ OK" : "✗ 阻擋中"
    i_bg = not use_insight ? c_off : i_ok ? c_pass : c_block

    table.cell(rtbl, 0, 0, "Filter", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 1, 0, "狀態", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 1, "① HTF RSI", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 1, h_txt, bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 2, "② Mutex", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 2, m_txt, bgcolor=m_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 3, "③ Footprint（覆蓋" + str.tostring(fp_cov, "#") + "%）", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 3, fp_val_txt + " " + fp_st_txt, bgcolor=fp_st_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 4, "④ 提早保本", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 4, be_txt, bgcolor=use_early_be ? c_on : c_off, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 5, "⑤ 時間市價", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 5, tf_txt, bgcolor=use_time_close_fix ? c_on : c_off, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 6, "⑥ Regime", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 6, r_txt, bgcolor=r_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 7, "⑦ Z-Score", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 7, z_txt, bgcolor=z_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 8, "⑧ 趨勢EMA", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 8, t_txt, bgcolor=t_bg, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 9, "⑨ 洞察濾網", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 9, i_txt, bgcolor=i_bg, text_color=color.white, text_size=size.small)
    vc_txt = not use_vol_climax ? "OFF" : is_vol_climax ? "✓ 爆量" : "✗ 量不足"
    vc_bg = not use_vol_climax ? c_off : is_vol_climax ? c_pass : c_block
    table.cell(rtbl, 0, 10, "⑩ Vol Climax", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 10, vc_txt, bgcolor=vc_bg, text_color=color.white, text_size=size.small)
    db_txt = not use_dxy_band ? "OFF" : in_dxy_dead_band ? "✗ 死亡區間" : "✓ OK（" + str.tostring(dxy_rsi_val, "#") + "）"
    db_bg = not use_dxy_band ? c_off : in_dxy_dead_band ? c_block : c_pass
    table.cell(rtbl, 0, 11, "⑪ DXY區間", bgcolor=c_hdr, text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 11, db_txt, bgcolor=db_bg, text_color=color.white, text_size=size.small)

//------------------------------------------------------------------------------
// 6. 統計表格 (Stats)
//------------------------------------------------------------------------------
var wins_total = array.new_int(5, 0)
var losses_total = array.new_int(5, 0)
var wins_asia = array.new_int(5, 0)
var losses_asia = array.new_int(5, 0)
var wins_euro = array.new_int(5, 0)
var losses_euro = array.new_int(5, 0)
var wins_us = array.new_int(5, 0)
var losses_us = array.new_int(5, 0)
var entryWeekdays = array.new_int()
var entrySessions = array.new_int()
var entryPrices = array.new_float()

t_us = time(timeframe.period, "2030-0500", "Asia/Taipei")
t_euro = time(timeframe.period, "1500-2030", "Asia/Taipei")

if strategy.position_size[1] == 0 and strategy.position_size > 0
    wd = dayofweek(time, "Asia/Taipei")
    array.push(entryWeekdays, wd)
    array.push(entryPrices, strategy.position_avg_price)
    sess_id = 0
    if not na(t_us)
        sess_id := 2
    else if not na(t_euro)
        sess_id := 1
    array.push(entrySessions, sess_id)

if strategy.position_size[1] > 0 and strategy.position_size == 0 and array.size(entryWeekdays) > 0
    wd = array.shift(entryWeekdays)
    sess = array.shift(entrySessions)
    ep = array.shift(entryPrices)
    profitValue = close - ep
    idx = wd - 2
    if idx >= 0 and idx < 5
        is_win = profitValue > 0
        if is_win
            array.set(wins_total, idx, array.get(wins_total, idx) + 1)
        else
            array.set(losses_total, idx, array.get(losses_total, idx) + 1)
        if sess == 0
            if is_win
                array.set(wins_asia, idx, array.get(wins_asia, idx) + 1)
            else
                array.set(losses_asia, idx, array.get(losses_asia, idx) + 1)
        else if sess == 1
            if is_win
                array.set(wins_euro, idx, array.get(wins_euro, idx) + 1)
            else
                array.set(losses_euro, idx, array.get(losses_euro, idx) + 1)
        else if sess == 2
            if is_win
                array.set(wins_us, idx, array.get(wins_us, idx) + 1)
            else
                array.set(losses_us, idx, array.get(losses_us, idx) + 1)

var table stats = table.new(position.bottom_right, show_detail_stats ? 5 : 2, 6, border_width=1, frame_color=color.black, frame_width=1)

f_txt(w, l) =>
    tot = w + l
    rate = tot > 0 ? w * 100.0 / tot : na
    str.tostring(w) + "/" + str.tostring(l) + "\n" + (na(rate) ? "-" : str.tostring(rate, "#") + "%")

if show_table
    bg_head = color.gray
    txt_head = color.white
    table.cell(stats, 0, 0, "Weekday", text_color=txt_head, bgcolor=bg_head)
    if show_detail_stats
        table.cell(stats, 1, 0, "Asia", text_color=txt_head, bgcolor=bg_head)
        table.cell(stats, 2, 0, "Euro", text_color=txt_head, bgcolor=bg_head)
        table.cell(stats, 3, 0, "US", text_color=txt_head, bgcolor=bg_head)
        table.cell(stats, 4, 0, "Total", text_color=txt_head, bgcolor=bg_head)
    else
        table.cell(stats, 1, 0, "Win/Loss (Rate)", text_color=txt_head, bgcolor=bg_head)
    for i = 0 to 4
        wa = array.get(wins_asia, i)
        la = array.get(losses_asia, i)
        we = array.get(wins_euro, i)
        le = array.get(losses_euro, i)
        wu = array.get(wins_us, i)
        lu = array.get(losses_us, i)
        wt = array.get(wins_total, i)
        lt = array.get(losses_total, i)
        dayLabel = i == 0 ? "Mon" : i == 1 ? "Tue" : i == 2 ? "Wed" : i == 3 ? "Thu" : "Fri"
        table.cell(stats, 0, i + 1, dayLabel, text_color=color.black, bgcolor=color.new(color.gray, 90))
        if show_detail_stats
            table.cell(stats, 1, i + 1, f_txt(wa, la), text_color=color.black, bgcolor=color.new(color.gray, 95))
            table.cell(stats, 2, i + 1, f_txt(we, le), text_color=color.black, bgcolor=color.new(color.gray, 95))
            table.cell(stats, 3, i + 1, f_txt(wu, lu), text_color=color.black, bgcolor=color.new(color.gray, 95))
            table.cell(stats, 4, i + 1, f_txt(wt, lt), text_color=color.black, bgcolor=color.new(color.gray, 90))
        else
            table.cell(stats, 1, i + 1, f_txt(wt, lt), text_color=color.black, bgcolor=color.new(color.gray, 90))
