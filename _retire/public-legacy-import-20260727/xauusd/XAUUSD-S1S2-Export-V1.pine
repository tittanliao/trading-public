// Indicator: XAUUSD-S1S2-Export-V1（資料匯出專用，需 TradingView Premium/Ultimate）
// 用途：掛在 30m FX_IDC:XAUUSD 圖上，「匯出圖表資料」產生 CSV，
//       餵給 xauusd/scripts/run_s1s2_filter_optimizer.py 做 S1/S2 全 filter 參數最佳化。
//
// 設計原則（20260712）：
//   1. 只匯出「Python 無法從 30m OHLC 重算」的值：
//      - FP_*：Footprint 訂單流系列（唯一不可替代的資料）
//      - TickVol：volume（先前的價格匯出沒有 volume 欄位）
//   2. CHK_*：校驗欄位——Python 會自己重算同樣的值並比對，確保重採樣/對齊邏輯
//      跟 TradingView 一致（值對上了才能信任最佳化結果）。這些欄位的參數寫死沒關係，
//      它們只是「對答案」用，實際最佳化時 Python 用自己重算的版本（參數自由）。
//   3. ⚠️ 匯出時整份 CSV 的 footprint 失衡門檻（imbalance_percent）與每列tick數
//      （ticks_per_row）是固定的（每腳本僅一次 request.footprint 呼叫）——
//      這兩個參數無法在 Python 端事後調整，要測不同值需改輸入後重新匯出。
//   4. 欄位標題不含逗號（避免破壞 CSV 解析）。
//
// 匯出步驟：
//   1. 開 30m FX_IDC:XAUUSD 圖，掛上本指標
//   2. 盡量往左捲動載入最多歷史K棒（Premium 上限約 20k 根 intraday）
//   3. 右上角「⋯」→ Export chart data →選 ISO time 格式
//   4. 存到 xauusd/csv/exports/（檔名不拘，跑 optimizer 時用 --export 指定路徑）
//@version=6
indicator("XAUUSD-S1S2-Export-V1", shorttitle="S1S2-Export", overlay=false)

//------------------------------------------------------------------------------
// Inputs（匯出時固定的參數）
//------------------------------------------------------------------------------
grp_fp = "=== Footprint（匯出時固定，改值需重匯）==="
fp_ticks_per_row = input.int(250, "每列 tick 數", minval=1, group=grp_fp)
fp_va_percent = input.int(70, "Value Area %", minval=50, maxval=95, group=grp_fp)
fp_imbalance_pct = input.int(300, "失衡判定門檻 %", minval=100, group=grp_fp)

grp_chk = "=== 校驗欄位參數（寫死即可，只用來對答案）==="
chk_ma_len = input.int(3, "CHK: 60m MA 週期", group=grp_chk)
chk_rsi_len = input.int(14, "CHK: RSI 週期", group=grp_chk)
chk_bbw_rank_len = input.int(60, "CHK: BBW rank 回看", group=grp_chk)

//------------------------------------------------------------------------------
// Footprint（唯一一次呼叫）
//------------------------------------------------------------------------------
footprint fp = request.footprint(fp_ticks_per_row, fp_va_percent, fp_imbalance_pct)

bool fp_data_ok = not na(fp)
float fp_delta_ratio = na
float fp_poc_pos = na
float fp_val_pos = na
float fp_vah_pos = na
float fp_total_vol = na
int fp_buy_stack_full = 0
int fp_buy_stack_low33 = 0
int fp_buy_stack_low50 = 0
bool fp_sell_imb_low33 = false
bool fp_sell_imb_low50 = false

float bar_range = high - low
float zone33_top = low + bar_range * 0.33
float zone50_top = low + bar_range * 0.50

if fp_data_ok
    float buyV = fp.buy_volume()
    float sellV = fp.sell_volume()
    fp_total_vol := buyV + sellV
    fp_delta_ratio := fp_total_vol > 0 ? (buyV - sellV) / fp_total_vol * 100 : 0.0
    volume_row pocRow = fp.poc()
    float poc_mid = (pocRow.up_price() + pocRow.down_price()) / 2
    fp_poc_pos := bar_range == 0 ? 50.0 : (poc_mid - low) / bar_range * 100
    volume_row valRow = fp.val()
    float val_mid = (valRow.up_price() + valRow.down_price()) / 2
    fp_val_pos := bar_range == 0 ? 50.0 : (val_mid - low) / bar_range * 100
    volume_row vahRow = fp.vah()
    float vah_mid = (vahRow.up_price() + vahRow.down_price()) / 2
    fp_vah_pos := bar_range == 0 ? 50.0 : (vah_mid - low) / bar_range * 100
    array<volume_row> rws = fp.rows()
    int streak_full = 0
    int streak_33 = 0
    int streak_50 = 0
    for r in rws
        float r_mid = (r.up_price() + r.down_price()) / 2
        bool buy_imb = r.has_buy_imbalance()
        bool sell_imb = r.has_sell_imbalance()
        if buy_imb
            streak_full += 1
            fp_buy_stack_full := math.max(fp_buy_stack_full, streak_full)
        else
            streak_full := 0
        if r_mid <= zone33_top and buy_imb
            streak_33 += 1
            fp_buy_stack_low33 := math.max(fp_buy_stack_low33, streak_33)
        else
            streak_33 := 0
        if r_mid <= zone50_top and buy_imb
            streak_50 += 1
            fp_buy_stack_low50 := math.max(fp_buy_stack_low50, streak_50)
        else
            streak_50 := 0
        if r_mid <= zone33_top and sell_imb
            fp_sell_imb_low33 := true
        if r_mid <= zone50_top and sell_imb
            fp_sell_imb_low50 := true

//------------------------------------------------------------------------------
// 校驗欄位（Python 重算後對答案用）
//------------------------------------------------------------------------------
chk_ma60 = request.security(syminfo.tickerid, "60", ta.sma(close, chk_ma_len), lookahead=barmerge.lookahead_off)
chk_rsi_chart = ta.rsi(close, chk_rsi_len)
chk_rsi60 = request.security(syminfo.tickerid, "60", ta.rsi(close, chk_rsi_len), lookahead=barmerge.lookahead_off)
chk_rsima60 = request.security(syminfo.tickerid, "60", ta.sma(ta.rsi(close, chk_rsi_len), chk_rsi_len), lookahead=barmerge.lookahead_off)
chk_bbwrank60 = request.security(syminfo.tickerid, "60", ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), chk_bbw_rank_len), lookahead=barmerge.lookahead_off)
chk_ema240_now = request.security(syminfo.tickerid, "240", ta.ema(close, 20), lookahead=barmerge.lookahead_off)
chk_ema240_pre = request.security(syminfo.tickerid, "240", ta.ema(close, 20)[10], lookahead=barmerge.lookahead_off)
chk_slope240 = na(chk_ema240_pre) or chk_ema240_pre == 0 ? 0.0 : (chk_ema240_now - chk_ema240_pre) / chk_ema240_pre * 100
chk_atr240 = request.security(syminfo.tickerid, "240", ta.atr(14), lookahead=barmerge.lookahead_off)
chk_z240 = na(chk_atr240) or chk_atr240 == 0 ? 0.0 : (close - chk_ema240_now) / chk_atr240
chk_wvwap = ta.vwap(hlc3, timeframe.change("1W"))

//------------------------------------------------------------------------------
// Plots（欄位標題 = CSV 欄位名，不含逗號）
//------------------------------------------------------------------------------
plot(fp_data_ok ? 1 : 0, title="FP_ok")
plot(fp_delta_ratio, title="FP_DeltaRatio")
plot(fp_poc_pos, title="FP_POCpos")
plot(fp_val_pos, title="FP_VALpos")
plot(fp_vah_pos, title="FP_VAHpos")
plot(fp_buy_stack_full, title="FP_BuyStackFull")
plot(fp_buy_stack_low33, title="FP_BuyStackLow33")
plot(fp_buy_stack_low50, title="FP_BuyStackLow50")
plot(fp_sell_imb_low33 ? 1 : 0, title="FP_SellImbLow33")
plot(fp_sell_imb_low50 ? 1 : 0, title="FP_SellImbLow50")
plot(fp_total_vol, title="FP_TotalVol")
plot(volume, title="TickVol")
plot(chk_ma60, title="CHK_MA60")
plot(chk_rsi_chart, title="CHK_RSI14")
plot(chk_rsi60, title="CHK_RSI60")
plot(chk_rsima60, title="CHK_RSIMA60")
plot(chk_bbwrank60, title="CHK_BBWrank60")
plot(chk_slope240, title="CHK_Slope240")
plot(chk_z240, title="CHK_Z240")
plot(chk_wvwap, title="CHK_WVWAP")
