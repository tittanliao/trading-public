// Strategy: XAUUSD-Long-S1-AweWithBB-V3.7
// V3.7 changes vs V3.6.3：
//   ① 移除：期貨對應（GC1!）、趨勢 EMA 過濾器、洞察濾網（DXY/RSI）、4H HTF RSI 過濾器 — 程式碼與相關輸入/計算/顯示全數清除
//   ② Regime 過濾器拆成 3 組獨立開關，各自可設定時框，方便單獨回測：
//        - 斜率過濾器（use_slope_filter，slope_tf，預設 OFF，240）
//        - BBW 高檔過濾器（use_bbw_high_filter，bbw_high_tf，預設 ON，60，門檻 70%）
//        - BBW 低檔過濾器（use_bbw_low_filter，bbw_low_tf，預設 OFF，240）
//   ③ 右上角 Regime 狀態表格改為顯示三組過濾器各自的數值與 PASS/BLOCK/OFF 狀態
//   ④ 時間出場預設 48 → 36 根K棒
//   ⑤ 所有過濾器開關的 tooltip 補上詳細公式與判斷條件
// Entry label: S1BB_LE  Exit: S1BB_TP1 / S1BB_TP2 / S1BB_SL / S1BB_TimeWin / S1BB_TimeLoss
//@version=6
strategy(title="XAUUSD-Long-S1-AweWithBB-V3.7",
 shorttitle="S1-Awe-V3.7",
 overlay = true,
 format=format.price,
 precision=2,
 default_qty_type=strategy.cash, initial_capital=10000,
 default_qty_value=10000, commission_value=0.00,
 slippage=1)

//------------------------------------------------------------------------------
// 1. 輸入 (Inputs)
//------------------------------------------------------------------------------
strategy.cancel_all()
MP = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

grp_risk = "=== 風險與出場 ==="
SL_Pct         = input.float(0.5, "固定止損 %",     step=0.1, group=grp_risk)
Profit_Ratio_1 = input.float(1.0, "TP1 盈虧比",     step=0.1, group=grp_risk)
Profit_Ratio_2 = input.float(3.5, "TP2 盈虧比",     step=0.1, group=grp_risk)
out_k_count    = input.int(36,    "時間出場（K棒）",          group=grp_risk)

grp_ind = "=== S1 核心指標 ==="
bb_length   = input.int(20,   minval=1, title="BB Length",       group=grp_ind)
bb_mult     = input.float(2.0, title="BB Multiplier",            group=grp_ind)
bb_source   = input(close,    title="BB Source",                 group=grp_ind)
fast_ma_len = input.int(3,    minval=2, title="Fast EMA Length", group=grp_ind)
ao_slow_len = input.int(34,   minval=1, title="AO Slow Length",  group=grp_ind)
ao_fast_len = input.int(5,    minval=1, title="AO Fast Length",  group=grp_ind)

grp_filter = "=== 1H MA 過濾器 ==="
use_ma1h_filter = input.bool(true, "啟用 1H MA 過濾器", group=grp_filter,
 tooltip="公式：ma1h = SMA(close, ma1h_length)，計算於 60 分鐘時框\n條件：close > ma1h 才允許進場（否則阻擋）")
ma1h_length     = input.int(3, minval=1, title="1H MA Length",   group=grp_filter)

// ── V3.7 Regime 過濾器：拆成 3 組獨立開關，各自可設定時框，方便單獨回測 ──
grp_regime_slope = "=== ★ Regime－斜率過濾器 ==="
use_slope_filter    = input.bool(false, "啟用 斜率過濾器", group=grp_regime_slope,
 tooltip="公式：slope_val = (EMA20_now － EMA20_10根前) / EMA20_10根前 × 100（%），計算於「斜率時框」\n條件：slope_val ≤ -regime_slope_thresh 時判定為下降方向 → 阻擋進場")
slope_tf             = input.timeframe("240", "斜率時框", group=grp_regime_slope)
regime_slope_thresh  = input.float(0.15, "EMA20 斜率門檻（%）", step=0.05, group=grp_regime_slope,
 tooltip="EMA20 10根斜率 ≤ -此值 = 下降方向")

grp_regime_bbwhigh = "=== ★ Regime－BBW 高檔過濾器 ==="
use_bbw_high_filter = input.bool(true, "啟用 BBW 高檔過濾器", group=grp_regime_bbwhigh,
 tooltip="公式：bbw_rank_high = PercentRank( StDev(close,20)×4 / SMA(close,20), 60 )，計算於「BBW 高檔時框」\n條件：bbw_rank_high ≥ regime_bbw_high 時判定為趨勢帶／波動擴張 → 阻擋進場")
bbw_high_tf          = input.timeframe("60", "BBW 高檔時框", group=grp_regime_bbwhigh)
regime_bbw_high      = input.float(70.0, "趨勢帶 BBW rank 門檻（%）", step=5.0, group=grp_regime_bbwhigh)

grp_regime_bbwlow = "=== ★ Regime－BBW 低檔過濾器 ==="
use_bbw_low_filter  = input.bool(false, "啟用 BBW 低檔過濾器", group=grp_regime_bbwlow,
 tooltip="公式：bbw_rank_low = PercentRank( StDev(close,20)×4 / SMA(close,20), 60 )，計算於「BBW 低檔時框」\n條件：bbw_rank_low < regime_bbw_min 時判定為壓縮帶（易生假突破）→ 阻擋進場")
bbw_low_tf           = input.timeframe("240", "BBW 低檔時框", group=grp_regime_bbwlow)
regime_bbw_min       = input.float(30.0, "最低 BBW rank（假突破防護）（%）", step=5.0, group=grp_regime_bbwlow)

grp_regime_disp = "=== Regime 顯示 ==="
show_regime_table = input.bool(true, "顯示 Regime 狀態表格（右上角）", group=grp_regime_disp)

grp_bb_pos = "=== BB 位置過濾器 ==="
use_bb_filter  = input.bool(false, "啟用 BB 位置過濾器", group=grp_bb_pos,
 tooltip="公式：bb_pct_b（%） = (close － bb_lower) / (bb_upper － bb_lower) × 100\n條件：bb_pct_b（%） ≥ bb_pct_b_min 才允許進場（否則阻擋）\nabove_upper（%B>100%）勝率 77.8%")
bb_pct_b_min   = input.float(60.0, "BB %B 最低門檻（%）", minval=0.0, maxval=200.0, step=5.0, group=grp_bb_pos)

grp_stat = "=== 統計面板 ==="
show_table        = input.bool(false, "顯示統計表格",     group=grp_stat)
show_detail_stats = input.bool(true,  "顯示詳細時段統計", group=grp_stat)

//------------------------------------------------------------------------------
// 2. 指標運算 (Indicators)
//------------------------------------------------------------------------------
// S1 核心：BB + AO
bb_basis = ta.sma(bb_source, bb_length)
bb_dev   = ta.stdev(bb_source, bb_length) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_pct_b = bb_dev > 0 ? (close - bb_lower) / (bb_upper - bb_lower) : 0.5

fast_ma    = ta.ema(bb_source, fast_ma_len)
xSMA1_hl2  = ta.sma(hl2, ao_fast_len)
xSMA2_hl2  = ta.sma(hl2, ao_slow_len)
AO_Val     = xSMA1_hl2 - xSMA2_hl2
AO_State   = AO_Val >= 0 ? (AO_Val > AO_Val[1] ? 1 : 2) : (AO_Val > AO_Val[1] ? -1 : -2)

// 1H MA
ma1h = request.security(syminfo.tickerid, "60", ta.sma(close, ma1h_length), lookahead=barmerge.lookahead_off)

// ── Regime 指標：斜率（獨立時框）──
ema20_slope_now = request.security(syminfo.tickerid, slope_tf, ta.ema(close, 20),     lookahead=barmerge.lookahead_off)
ema20_slope_pre = request.security(syminfo.tickerid, slope_tf, ta.ema(close, 20)[10], lookahead=barmerge.lookahead_off)
slope_val       = na(ema20_slope_pre) or ema20_slope_pre == 0 ? 0.0 : (ema20_slope_now - ema20_slope_pre) / ema20_slope_pre * 100
is_slope_down   = slope_val <= -regime_slope_thresh

// ── Regime 指標：BBW 高檔（獨立時框）──
bbw_rank_high = request.security(syminfo.tickerid, bbw_high_tf,
 ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), 60),
 lookahead=barmerge.lookahead_off)
is_bbw_high   = bbw_rank_high >= regime_bbw_high

// ── Regime 指標：BBW 低檔（獨立時框）──
bbw_rank_low = request.security(syminfo.tickerid, bbw_low_tf,
 ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), 60),
 lookahead=barmerge.lookahead_off)
is_bbw_low   = bbw_rank_low < regime_bbw_min

// 所有過濾條件
filter_1h_ok  = not use_ma1h_filter    or close > ma1h
bb_pos_ok     = not use_bb_filter      or bb_pct_b * 100 >= bb_pct_b_min
slope_ok      = not use_slope_filter    or not is_slope_down
bbw_high_ok   = not use_bbw_high_filter or not is_bbw_high
bbw_low_ok    = not use_bbw_low_filter  or not is_bbw_low
regime_ok     = slope_ok and bbw_high_ok and bbw_low_ok

//------------------------------------------------------------------------------
// 3. 進場邏輯 (Entry)
//------------------------------------------------------------------------------
MaxUseBars = 1 + math.max(bb_length, 1)
var LongEntry = false

LongCondition = ta.crossover(fast_ma, bb_basis) and
 close > bb_basis and math.abs(AO_State) == 1 and
 filter_1h_ok and bb_pos_ok and regime_ok

LongEntry := bar_index > MaxUseBars and MP == 0 and LongCondition


if LongEntry
    strategy.entry("S1BB_LE", strategy.long, comment="S1BB_LE")

//------------------------------------------------------------------------------
// 4. 出場邏輯 (Exit)
//------------------------------------------------------------------------------
EntryPrice     = strategy.opentrades.entry_price(strategy.opentrades - 1)
BarsSinceEntry = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
SLPrice        = EntryPrice * (1 - SL_Pct / 100)
PTPrice1       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_1)
PTPrice2       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_2)

var float exit_stop_price = na

if MP > 0
    if close >= PTPrice2
        exit_stop_price := math.max(PTPrice2, ta.lowest(low, out_k_count / 4))
        strategy.exit("S1BB_TP2", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP2")
    else if close >= PTPrice1
        exit_stop_price := math.max(PTPrice1, ta.lowest(low, out_k_count / 2))
        strategy.exit("S1BB_TP1", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP1")
    else
        strategy.exit("S1BB_SL", from_entry="S1BB_LE", stop=SLPrice, comment_loss="S1BB_SL")
    if BarsSinceEntry >= out_k_count
        if strategy.openprofit >= 0
            exit_stop_price := math.max(SLPrice, ta.lowest(low, out_k_count))
            strategy.exit("S1BB_TimeWin",  from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeWin")
        else
            exit_stop_price := low
            strategy.exit("S1BB_TimeLoss", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeLoss")

alertcondition(LongEntry, title="S1BB Entry", message="S1BB Breakout Buy, Price={{close}}")

//------------------------------------------------------------------------------
// 5. 視覺化 (Visualization)
//------------------------------------------------------------------------------
plot(bb_basis, "Basis", color.new(color.red,   0), 2)
p1 = plot(bb_upper, "Upper", color.new(color.blue, 0))
p2 = plot(bb_lower, "Lower", color.new(color.blue, 0))
fill(p1, p2, color.new(color.silver, 90))
plot(fast_ma,   "Fast EMA",  color.new(color.black,  0))

// Background: 各過濾器狀態
bgcolor(use_slope_filter    and is_slope_down ? color.new(color.orange, 88) : na, title="Regime: Slope Down")
bgcolor(use_bbw_high_filter and is_bbw_high   ? color.new(color.red,    90) : na, title="Regime: BBW High")
bgcolor(use_bbw_low_filter  and is_bbw_low    ? color.new(color.gray,   88) : na, title="Regime: BBW Low")

// 被過濾訊號（灰色箭頭）
raw_signal = ta.crossover(fast_ma, bb_basis) and close > bb_basis and math.abs(AO_State) == 1 and filter_1h_ok
plotshape(raw_signal and not LongEntry, title="Filtered", style=shape.triangleup,
 location=location.belowbar, color=color.new(color.gray, 60), size=size.tiny, text="x")

// 進場 label
if strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    yPos = high * 1.002
    txt = "S1BB_LE\n" + str.tostring(EntryPrice, "#.##") +
          "\nSL: "  + str.tostring(SLPrice,   "#.##") +
          "\nTP1: " + str.tostring(PTPrice1,  "#.##") +
          "\nTP2: " + str.tostring(PTPrice2,  "#.##")
    if use_slope_filter
        txt += "\n[Slope " + slope_tf + "] " + str.tostring(slope_val,"#.##") + "%  " + (slope_ok?"✓":"✗ Down")
    if use_bbw_high_filter
        txt += "\n[BBW High " + bbw_high_tf + "] " + str.tostring(bbw_rank_high,"#") + "%  " + (bbw_high_ok?"✓":"✗ High")
    if use_bbw_low_filter
        txt += "\n[BBW Low " + bbw_low_tf + "] " + str.tostring(bbw_rank_low,"#") + "%  " + (bbw_low_ok?"✓":"✗ Low")
    if use_bb_filter
        txt += "\n[BB%B] " + str.tostring(bb_pct_b*100,"#.#") + "%" + (bb_pos_ok?" ✓":" ✗")
    label.new(bar_index, yPos, txt, style=label.style_label_down,
     color=color.new(color.teal,0), textcolor=color.white, size=size.small)

// Regime 狀態表格（右上角）
var table rtbl = table.new(position.top_right, 3, 4, border_width=1, frame_color=color.gray, frame_width=1)

if show_regime_table and barstate.islast
    table.cell(rtbl, 0, 0, "Regime Filter", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 1, 0, "Value",         bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(rtbl, 2, 0, "Status",        bgcolor=color.gray, text_color=color.white, text_size=size.small)

    table.cell(rtbl, 0, 1, "Slope (" + slope_tf + ")", bgcolor=color.new(color.gray,80), text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 1, str.tostring(slope_val,"#.##") + "%",
     bgcolor=is_slope_down ? color.new(color.red,70) : color.new(color.green,70),
     text_color=color.black, text_size=size.small)
    table.cell(rtbl, 2, 1, not use_slope_filter ? "OFF" : (slope_ok ? "PASS" : "BLOCK"),
     bgcolor=not use_slope_filter ? color.new(color.gray,70) : (slope_ok ? color.new(color.teal,60) : color.new(color.red,60)),
     text_color=color.white, text_size=size.small)

    table.cell(rtbl, 0, 2, "BBW High (" + bbw_high_tf + ")", bgcolor=color.new(color.gray,80), text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 2, str.tostring(bbw_rank_high,"#.1") + "%",
     bgcolor=is_bbw_high ? color.new(color.orange,70) : color.new(color.green,70),
     text_color=color.black, text_size=size.small)
    table.cell(rtbl, 2, 2, not use_bbw_high_filter ? "OFF" : (bbw_high_ok ? "PASS" : "BLOCK"),
     bgcolor=not use_bbw_high_filter ? color.new(color.gray,70) : (bbw_high_ok ? color.new(color.teal,60) : color.new(color.red,60)),
     text_color=color.white, text_size=size.small)

    table.cell(rtbl, 0, 3, "BBW Low (" + bbw_low_tf + ")", bgcolor=color.new(color.gray,80), text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 3, str.tostring(bbw_rank_low,"#.1") + "%",
     bgcolor=is_bbw_low ? color.new(color.gray,60) : color.new(color.green,70),
     text_color=color.black, text_size=size.small)
    table.cell(rtbl, 2, 3, not use_bbw_low_filter ? "OFF" : (bbw_low_ok ? "PASS" : "BLOCK"),
     bgcolor=not use_bbw_low_filter ? color.new(color.gray,70) : (bbw_low_ok ? color.new(color.teal,60) : color.new(color.red,60)),
     text_color=color.white, text_size=size.small)

//------------------------------------------------------------------------------
// 6. 統計表格 (Stats)
//------------------------------------------------------------------------------
var wins_total = array.new_int(5,0)
var losses_total = array.new_int(5,0)
var wins_asia  = array.new_int(5,0)
var losses_asia  = array.new_int(5,0)
var wins_euro  = array.new_int(5,0)
var losses_euro  = array.new_int(5,0)
var wins_us    = array.new_int(5,0)
var losses_us    = array.new_int(5,0)
var entryWeekdays = array.new_int()
var entrySessions = array.new_int()
var entryPrices = array.new_float()

t_us   = time(timeframe.period, "2030-0500", "Asia/Taipei")
t_euro = time(timeframe.period, "1500-2030", "Asia/Taipei")

if strategy.position_size[1] == 0 and strategy.position_size > 0
    wd = dayofweek(time, "Asia/Taipei")
    array.push(entryWeekdays, wd)
    array.push(entryPrices, strategy.position_avg_price)
    sess_id = 0
    if not na(t_us)
        sess_id := 2
    else if not na(t_euro)
        sess_id := 1
    array.push(entrySessions, sess_id)

if strategy.position_size[1] > 0 and strategy.position_size == 0 and array.size(entryWeekdays) > 0
    wd  = array.shift(entryWeekdays)
    sess = array.shift(entrySessions)
    ep  = array.shift(entryPrices)
    idx = wd - 2
    if idx >= 0 and idx < 5
        is_win = close - ep > 0
        if is_win
            array.set(wins_total, idx, array.get(wins_total,idx)+1)
        else
            array.set(losses_total, idx, array.get(losses_total,idx)+1)
        if sess == 0
            if is_win
                array.set(wins_asia,  idx, array.get(wins_asia, idx)+1)
            else
                array.set(losses_asia, idx, array.get(losses_asia,idx)+1)
        else if sess == 1
            if is_win
                array.set(wins_euro,  idx, array.get(wins_euro, idx)+1)
            else
                array.set(losses_euro, idx, array.get(losses_euro,idx)+1)
        else if sess == 2
            if is_win
                array.set(wins_us,    idx, array.get(wins_us,  idx)+1)
            else
                array.set(losses_us,   idx, array.get(losses_us,  idx)+1)

var table stats = table.new(position.bottom_right, show_detail_stats?5:2, 6, border_width=1, frame_color=color.black, frame_width=1)
f_txt(w,l) =>
    tot = w+l
    str.tostring(w)+"/"+str.tostring(l)+"\n"+(tot>0?str.tostring(w*100.0/tot,"#")+"%":"-")

if show_table
    table.cell(stats,0,0,"Weekday",text_color=color.white,bgcolor=color.gray)
    if show_detail_stats
        table.cell(stats,1,0,"Asia", text_color=color.white,bgcolor=color.gray)
        table.cell(stats,2,0,"Euro", text_color=color.white,bgcolor=color.gray)
        table.cell(stats,3,0,"US",   text_color=color.white,bgcolor=color.gray)
        table.cell(stats,4,0,"Total",text_color=color.white,bgcolor=color.gray)
    else
        table.cell(stats,1,0,"Win/Loss",text_color=color.white,bgcolor=color.gray)
    for i = 0 to 4
        wa=array.get(wins_asia,i)
        la=array.get(losses_asia,i)
        we=array.get(wins_euro,i)
        le=array.get(losses_euro,i)
        wu=array.get(wins_us,i)
        lu=array.get(losses_us,i)
        wt=array.get(wins_total,i)
        lt=array.get(losses_total,i)
        dl = i==0?"Mon":i==1?"Tue":i==2?"Wed":i==3?"Thu":"Fri"
        table.cell(stats,0,i+1,dl,text_color=color.black,bgcolor=color.new(color.gray,90))
        if show_detail_stats
            table.cell(stats,1,i+1,f_txt(wa,la),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,2,i+1,f_txt(we,le),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,3,i+1,f_txt(wu,lu),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,4,i+1,f_txt(wt,lt),text_color=color.black,bgcolor=color.new(color.gray,90))
        else
            table.cell(stats,1,i+1,f_txt(wt,lt),text_color=color.black,bgcolor=color.new(color.gray,90))
