// Strategy: XAUUSD-Long-S1-AweWithBB-V3.6.3
// V3.6.3 changes vs V3.6.2：新增 Regime 過濾器（Market Regime Filter）
//   ① 阻擋 BEAR_TREND（4H bbw_rank ≥ 65% + slope ≤ -0.15%）—— S1 在此環境期望值 -0.28R（2026 H1 數據）
//   ② 阻擋低 BBW（4H bbw_rank < 30%）—— 64% 的 S1 假突破發生在此區
//   ③ 新增右上角 Regime 狀態表格（slope_4h / bbw_rank / 當前 Regime）
//   所有過濾器預設 OFF，與 V3.6.2 行為完全一致
// Entry label: S1BB_LE  Exit: S1BB_TP1 / S1BB_TP2 / S1BB_SL / S1BB_TimeWin / S1BB_TimeLoss
//@version=6
strategy(title="XAUUSD-Long-S1-AweWithBB-V3.6.3",
 shorttitle="S1-Awe-V3.6.3",
 overlay = true,
 format=format.price,
 precision=2,
 default_qty_type=strategy.cash, initial_capital=10000,
 default_qty_value=10000, commission_value=0.00,
 slippage=1)

//------------------------------------------------------------------------------
// 1. 輸入 (Inputs)
//------------------------------------------------------------------------------
strategy.cancel_all()
MP = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

grp_fut = "=== 期貨對應 ==="
show_futures = input.bool(true, "顯示 GC1! 對應價格", group=grp_fut)
futures_sym  = input.symbol("COMEX:GC1!", "期貨代碼", group=grp_fut)

grp_risk = "=== 風險與出場 ==="
SL_Pct         = input.float(0.5, "固定止損 %",     step=0.1, group=grp_risk)
Profit_Ratio_1 = input.float(1.0, "TP1 盈虧比",     step=0.1, group=grp_risk)
Profit_Ratio_2 = input.float(3.5, "TP2 盈虧比",     step=0.1, group=grp_risk)
out_k_count    = input.int(48,    "時間出場（K棒）",          group=grp_risk)

grp_ind = "=== S1 核心指標 ==="
bb_length   = input.int(20,   minval=1, title="BB Length",       group=grp_ind)
bb_mult     = input.float(2.0, title="BB Multiplier",            group=grp_ind)
bb_source   = input(close,    title="BB Source",                 group=grp_ind)
fast_ma_len = input.int(3,    minval=2, title="Fast EMA Length", group=grp_ind)
ao_slow_len = input.int(34,   minval=1, title="AO Slow Length",  group=grp_ind)
ao_fast_len = input.int(5,    minval=1, title="AO Fast Length",  group=grp_ind)

grp_filter = "=== 1H MA 過濾器 ==="
use_ma1h_filter = input.bool(true, "啟用 1H MA 過濾器", group=grp_filter)
ma1h_length     = input.int(3, minval=1, title="1H MA Length",   group=grp_filter)

// ── V3.6.3 新增：Regime 過濾器 ──
grp_regime = "=== ★ Regime 過濾器（V3.6.3）==="
use_regime_filter   = input.bool(false, "啟用 Regime 過濾器",
 group=grp_regime,
 tooltip="根據 2026 H1 分析（188 筆真實交易）：\n① BEAR_TREND（4H 高波動+下跌）S1 期望值 -0.28R ❌\n② BBW rank < 30%（壓縮帶）64% 為假突破 ❌\n開啟後同時阻擋兩種環境，預設 OFF 行為與 V3.6.2 相同")
show_regime_table   = input.bool(true,  "顯示 Regime 狀態表格（右上角）", group=grp_regime)
regime_slope_thresh = input.float(0.15, "EMA20 斜率門檻（%）",  step=0.05, group=grp_regime,
 tooltip="4H EMA20 10根斜率 ≤ -此值 = 下降方向\n配合高 BBW 即判定為 BEAR_TREND")
regime_bbw_high     = input.float(65.0, "趨勢帶 BBW rank 門檻（%）", step=5.0, group=grp_regime,
 tooltip="4H BBW rank ≥ 65% = 趨勢帶（波動擴張中）")
regime_bbw_min      = input.float(30.0, "最低 BBW rank（假突破防護）（%）", step=5.0, group=grp_regime,
 tooltip="4H BBW rank < 30% 時突破 64% 為假突破\n建議值：30%")

grp_trend = "=== 趨勢 EMA 過濾器 ==="
use_trend_filter = input.bool(false, "啟用趨勢 EMA 過濾器", group=grp_trend,
 tooltip="打開 = close 需高於指定時框 EMA 才進場\n與 S2A/S2B 同架構")
trend_tf  = input.string("240", "趨勢 EMA 時框", options=["60","240"], group=grp_trend)
trend_len = input.int(200, "趨勢 EMA 週期", minval=50, group=grp_trend)

grp_insight = "=== 洞察濾網 ==="
use_insight    = input.bool(false, "啟用洞察濾網", group=grp_insight,
 tooltip="DXY RSI 日線 + RSI 動能確認")
dxy_rsi_thresh  = input.int(50, "DXY RSI 日線門檻（< 此值）", minval=20, maxval=80, group=grp_insight)
rsi_len_insight = input.int(14, "RSI 週期（動能確認）",        minval=5,            group=grp_insight)

grp_bb_pos = "=== BB 位置過濾器 ==="
use_bb_filter  = input.bool(false, "啟用 BB 位置過濾器", group=grp_bb_pos,
 tooltip="只在 BB %B ≥ 門檻時進場\nabove_upper（%B>1）勝率 77.8%")
bb_pct_b_min   = input.float(0.6, "BB %B 最低門檻", minval=0.0, maxval=2.0, step=0.05, group=grp_bb_pos)

grp_htf = "=== 4H HTF RSI 過濾器 ==="
use_htf_filter  = input.bool(false, "啟用 4H HTF 過濾器", group=grp_htf,
 tooltip="跳過 4H RSI 看空狀態（RSI < RSI-MA 且斜率負）\n4H bearish 勝率 47.9% vs bullish 64.0%")
htf_rsi_len    = input.int(14, "4H RSI 週期",    minval=5, group=grp_htf)
htf_rsi_ma_len = input.int(14, "4H RSI-MA 週期", minval=3, group=grp_htf)

grp_stat = "=== 統計面板 ==="
show_table        = input.bool(false, "顯示統計表格",     group=grp_stat)
show_detail_stats = input.bool(true,  "顯示詳細時段統計", group=grp_stat)

//------------------------------------------------------------------------------
// 2. 指標運算 (Indicators)
//------------------------------------------------------------------------------
// S1 核心：BB + AO
bb_basis = ta.sma(bb_source, bb_length)
bb_dev   = ta.stdev(bb_source, bb_length) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev
bb_pct_b = bb_dev > 0 ? (close - bb_lower) / (bb_upper - bb_lower) : 0.5

fast_ma    = ta.ema(bb_source, fast_ma_len)
xSMA1_hl2  = ta.sma(hl2, ao_fast_len)
xSMA2_hl2  = ta.sma(hl2, ao_slow_len)
AO_Val     = xSMA1_hl2 - xSMA2_hl2
AO_State   = AO_Val >= 0 ? (AO_Val > AO_Val[1] ? 1 : 2) : (AO_Val > AO_Val[1] ? -1 : -2)

// 1H MA
ma1h = request.security(syminfo.tickerid, "60", ta.sma(close, ma1h_length), lookahead=barmerge.lookahead_off)

// 趨勢 EMA
trend_ema = request.security(syminfo.tickerid, trend_tf, ta.ema(close, trend_len), lookahead=barmerge.lookahead_off)

// 期貨價差
fut_close    = request.security(futures_sym, timeframe.period, close)
basis_spread = fut_close - close

// 洞察：DXY RSI 日線
dxy_rsi_d = request.security("TVC:DXY", "D", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)

// 洞察：RSI 動能
rsi_curr        = ta.rsi(close, rsi_len_insight)
rsi_momentum_ok = rsi_curr > rsi_curr[1]

// 4H HTF RSI
htf_rsi_val     = request.security(syminfo.tickerid, "240", ta.rsi(close, htf_rsi_len),                                         lookahead=barmerge.lookahead_off)
htf_rsi_ma      = request.security(syminfo.tickerid, "240", ta.sma(ta.rsi(close, htf_rsi_len), htf_rsi_ma_len),                 lookahead=barmerge.lookahead_off)
htf_rsi_ma_prev = request.security(syminfo.tickerid, "240", ta.sma(ta.rsi(close, htf_rsi_len), htf_rsi_ma_len)[1],              lookahead=barmerge.lookahead_off)
htf_is_bearish  = htf_rsi_val < htf_rsi_ma and htf_rsi_ma < htf_rsi_ma_prev

// ── Regime 指標（4H 時框）──
ema20_4h_now = request.security(syminfo.tickerid, "240", ta.ema(close, 20),     lookahead=barmerge.lookahead_off)
ema20_4h_pre = request.security(syminfo.tickerid, "240", ta.ema(close, 20)[10], lookahead=barmerge.lookahead_off)
slope_4h     = na(ema20_4h_pre) or ema20_4h_pre == 0 ? 0.0 : (ema20_4h_now - ema20_4h_pre) / ema20_4h_pre * 100
bbw_rank_4h  = request.security(syminfo.tickerid, "240",
 ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), 60),
 lookahead=barmerge.lookahead_off)

is_bear_trend_4h = slope_4h <= -regime_slope_thresh and bbw_rank_4h >= regime_bbw_high
is_low_bbw_4h    = bbw_rank_4h < regime_bbw_min

// 所有過濾條件
filter_1h_ok = not use_ma1h_filter  or close > ma1h
trend_ok     = not use_trend_filter or close > trend_ema
insight_ok   = not use_insight      or (dxy_rsi_d < dxy_rsi_thresh and rsi_momentum_ok)
bb_pos_ok    = not use_bb_filter    or bb_pct_b >= bb_pct_b_min
htf_ok       = not use_htf_filter   or not htf_is_bearish
regime_ok    = not use_regime_filter or (not is_bear_trend_4h and not is_low_bbw_4h)

//------------------------------------------------------------------------------
// 3. 進場邏輯 (Entry)
//------------------------------------------------------------------------------
MaxUseBars = 1 + math.max(bb_length, 1)
var LongEntry = false

LongCondition = ta.crossover(fast_ma, bb_basis) and
 close > bb_basis and math.abs(AO_State) == 1 and
 filter_1h_ok and trend_ok and insight_ok and bb_pos_ok and htf_ok and regime_ok

LongEntry := bar_index > MaxUseBars and MP == 0 and LongCondition

if LongEntry
    strategy.entry("S1BB_LE", strategy.long, comment="S1BB_LE")

//------------------------------------------------------------------------------
// 4. 出場邏輯 (Exit)
//------------------------------------------------------------------------------
EntryPrice     = strategy.opentrades.entry_price(strategy.opentrades - 1)
BarsSinceEntry = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
SLPrice        = EntryPrice * (1 - SL_Pct / 100)
PTPrice1       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_1)
PTPrice2       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_2)

var float exit_stop_price = na

if MP > 0
    if close >= PTPrice2
        exit_stop_price := math.max(PTPrice2, ta.lowest(low, out_k_count / 4))
        strategy.exit("S1BB_TP2", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP2")
    else if close >= PTPrice1
        exit_stop_price := math.max(PTPrice1, ta.lowest(low, out_k_count / 2))
        strategy.exit("S1BB_TP1", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP1")
    else
        strategy.exit("S1BB_SL", from_entry="S1BB_LE", stop=SLPrice, comment_loss="S1BB_SL")
    if BarsSinceEntry >= out_k_count
        if strategy.openprofit >= 0
            exit_stop_price := math.max(SLPrice, ta.lowest(low, out_k_count))
            strategy.exit("S1BB_TimeWin",  from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeWin")
        else
            exit_stop_price := low
            strategy.exit("S1BB_TimeLoss", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeLoss")

alertcondition(LongEntry, title="S1BB Entry", message="S1BB Breakout Buy, Price={{close}}")

//------------------------------------------------------------------------------
// 5. 視覺化 (Visualization)
//------------------------------------------------------------------------------
plot(bb_basis, "Basis", color.new(color.red,   0), 2)
p1 = plot(bb_upper, "Upper", color.new(color.blue, 0))
p2 = plot(bb_lower, "Lower", color.new(color.blue, 0))
fill(p1, p2, color.new(color.silver, 90))
plot(fast_ma,   "Fast EMA",  color.new(color.black,  0))
plot(use_trend_filter ? trend_ema : na, "Trend EMA", color.new(color.purple, 0), 1)

// Background: 各過濾器狀態
bgcolor(use_insight    and dxy_rsi_d < dxy_rsi_thresh ? color.new(color.green,  95) : na, title="DXY Favorable")
bgcolor(use_htf_filter and htf_is_bearish              ? color.new(color.red,    93) : na, title="4H Bearish")
bgcolor(use_regime_filter and is_bear_trend_4h         ? color.new(color.orange, 88) : na, title="Regime: BEAR_TREND")
bgcolor(use_regime_filter and is_low_bbw_4h and not is_bear_trend_4h ? color.new(color.gray, 88) : na, title="Regime: Low BBW")

// 被過濾訊號（灰色箭頭）
raw_signal = ta.crossover(fast_ma, bb_basis) and close > bb_basis and math.abs(AO_State) == 1 and filter_1h_ok
plotshape(raw_signal and not LongEntry, "Filtered", location.belowbar,
 color.new(color.gray, 60), shape.triangleup, size.tiny, text="x")

// 進場 label
if strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    yPos = high * 1.002
    txt = "S1BB_LE\n" + str.tostring(EntryPrice, "#.##") +
          "\nSL: "  + str.tostring(SLPrice,   "#.##") +
          "\nTP1: " + str.tostring(PTPrice1,  "#.##") +
          "\nTP2: " + str.tostring(PTPrice2,  "#.##")
    if use_regime_filter
        r_lbl = is_bear_trend_4h ? "BEAR_TREND ✗" : is_low_bbw_4h ? "LowBBW ✗" : "OK ✓"
        txt += "\n[Regime] " + r_lbl + "  slope=" + str.tostring(slope_4h,"#.##") + "% bbw=" + str.tostring(bbw_rank_4h,"#") + "%"
    if use_insight
        txt += "\n[Insight] DXY:" + str.tostring(dxy_rsi_d,"#.#") + " Mom:" + (rsi_momentum_ok?"✓":"✗")
    if use_bb_filter
        txt += "\n[BB%B] " + str.tostring(bb_pct_b,"#.##") + (bb_pos_ok?" ✓":" ✗")
    if use_htf_filter
        txt += "\n[4H RSI] " + (htf_is_bearish?"✗ Bear":"✓ OK")
    if use_trend_filter
        txt += "\n[EMA" + str.tostring(trend_len) + "] " + (close > trend_ema?"✓":"✗")
    if show_futures
        txt += "\n\nGC1!\nLE: " + str.tostring(EntryPrice+basis_spread,"#.##") +
               "\nSL: " + str.tostring(SLPrice+basis_spread,"#.##") +
               "\nTP1: " + str.tostring(PTPrice1+basis_spread,"#.##") +
               "\nTP2: " + str.tostring(PTPrice2+basis_spread,"#.##") +
               "\n(Basis: " + str.tostring(basis_spread,"#.##") + ")"
    label.new(bar_index, yPos, txt, style=label.style_label_down,
     color=color.new(color.teal,0), textcolor=color.white, size=size.small)

// Regime 狀態表格（右上角）
var table rtbl = table.new(position.top_right, 2, 4, border_width=1, frame_color=color.gray, frame_width=1)

if show_regime_table and barstate.islast
    r_name  = is_bear_trend_4h ? "🔴 BEAR_TREND" : is_low_bbw_4h ? "⚠ Low BBW" : "✅ OK / PASS"
    r_color = is_bear_trend_4h ? color.new(color.red,40) : is_low_bbw_4h ? color.new(color.orange,40) : color.new(color.teal,40)
    table.cell(rtbl, 0, 0, "Regime",    bgcolor=color.gray,              text_color=color.white, text_size=size.small)
    table.cell(rtbl, 1, 0, r_name,      bgcolor=r_color,                 text_color=color.white, text_size=size.small)
    table.cell(rtbl, 0, 1, "slope 4H",  bgcolor=color.new(color.gray,80),text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 1, str.tostring(slope_4h,"#.##") + "%",
     bgcolor=slope_4h >= regime_slope_thresh ? color.new(color.green,70) : slope_4h <= -regime_slope_thresh ? color.new(color.red,70) : color.new(color.gray,80),
     text_color=color.black, text_size=size.small)
    table.cell(rtbl, 0, 2, "BBW rank",  bgcolor=color.new(color.gray,80),text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 2, str.tostring(bbw_rank_4h,"#.1") + "%",
     bgcolor=bbw_rank_4h >= regime_bbw_high ? color.new(color.orange,70) : bbw_rank_4h < regime_bbw_min ? color.new(color.gray,70) : color.new(color.green,70),
     text_color=color.black, text_size=size.small)
    filter_txt = use_regime_filter ? "ON" : "OFF"
    table.cell(rtbl, 0, 3, "Filter",    bgcolor=color.new(color.gray,80),text_color=color.black, text_size=size.small)
    table.cell(rtbl, 1, 3, filter_txt,
     bgcolor=use_regime_filter ? color.new(color.teal,60) : color.new(color.gray,70),
     text_color=color.white, text_size=size.small)

//------------------------------------------------------------------------------
// 6. 統計表格 (Stats)
//------------------------------------------------------------------------------
var wins_total = array.new_int(5,0), var losses_total = array.new_int(5,0)
var wins_asia  = array.new_int(5,0), var losses_asia  = array.new_int(5,0)
var wins_euro  = array.new_int(5,0), var losses_euro  = array.new_int(5,0)
var wins_us    = array.new_int(5,0), var losses_us    = array.new_int(5,0)
var entryWeekdays = array.new_int(), var entrySessions = array.new_int(), var entryPrices = array.new_float()

t_us   = time(timeframe.period, "2030-0500", "Asia/Taipei")
t_euro = time(timeframe.period, "1500-2030", "Asia/Taipei")

if strategy.position_size[1] == 0 and strategy.position_size > 0
    wd = dayofweek(time, "Asia/Taipei")
    array.push(entryWeekdays, wd)
    array.push(entryPrices, strategy.position_avg_price)
    sess_id = 0
    if not na(t_us)
        sess_id := 2
    else if not na(t_euro)
        sess_id := 1
    array.push(entrySessions, sess_id)

if strategy.position_size[1] > 0 and strategy.position_size == 0 and array.size(entryWeekdays) > 0
    wd  = array.shift(entryWeekdays)
    sess = array.shift(entrySessions)
    ep  = array.shift(entryPrices)
    idx = wd - 2
    if idx >= 0 and idx < 5
        is_win = close - ep > 0
        if is_win
            array.set(wins_total, idx, array.get(wins_total,idx)+1)
        else
            array.set(losses_total, idx, array.get(losses_total,idx)+1)
        if sess == 0
            if is_win, array.set(wins_asia,  idx, array.get(wins_asia, idx)+1)
            else,      array.set(losses_asia, idx, array.get(losses_asia,idx)+1)
        else if sess == 1
            if is_win, array.set(wins_euro,  idx, array.get(wins_euro, idx)+1)
            else,      array.set(losses_euro, idx, array.get(losses_euro,idx)+1)
        else if sess == 2
            if is_win, array.set(wins_us,    idx, array.get(wins_us,  idx)+1)
            else,      array.set(losses_us,   idx, array.get(losses_us,  idx)+1)

var table stats = table.new(position.bottom_right, show_detail_stats?5:2, 6, border_width=1, frame_color=color.black, frame_width=1)
f_txt(w,l) =>
    tot = w+l
    str.tostring(w)+"/"+str.tostring(l)+"\n"+(tot>0?str.tostring(w*100.0/tot,"#")+"%":"-")

if show_table
    table.cell(stats,0,0,"Weekday",text_color=color.white,bgcolor=color.gray)
    if show_detail_stats
        table.cell(stats,1,0,"Asia", text_color=color.white,bgcolor=color.gray)
        table.cell(stats,2,0,"Euro", text_color=color.white,bgcolor=color.gray)
        table.cell(stats,3,0,"US",   text_color=color.white,bgcolor=color.gray)
        table.cell(stats,4,0,"Total",text_color=color.white,bgcolor=color.gray)
    else
        table.cell(stats,1,0,"Win/Loss",text_color=color.white,bgcolor=color.gray)
    for i = 0 to 4
        wa=array.get(wins_asia,i),  la=array.get(losses_asia,i)
        we=array.get(wins_euro,i),  le=array.get(losses_euro,i)
        wu=array.get(wins_us,i),    lu=array.get(losses_us,i)
        wt=array.get(wins_total,i), lt=array.get(losses_total,i)
        dl = i==0?"Mon":i==1?"Tue":i==2?"Wed":i==3?"Thu":"Fri"
        table.cell(stats,0,i+1,dl,text_color=color.black,bgcolor=color.new(color.gray,90))
        if show_detail_stats
            table.cell(stats,1,i+1,f_txt(wa,la),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,2,i+1,f_txt(we,le),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,3,i+1,f_txt(wu,lu),text_color=color.black,bgcolor=color.new(color.gray,95))
            table.cell(stats,4,i+1,f_txt(wt,lt),text_color=color.black,bgcolor=color.new(color.gray,90))
        else
            table.cell(stats,1,i+1,f_txt(wt,lt),text_color=color.black,bgcolor=color.new(color.gray,90))
