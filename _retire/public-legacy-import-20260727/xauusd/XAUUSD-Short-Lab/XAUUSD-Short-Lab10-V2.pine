// © Tittan
// Strategy: XAUUSD-Short-Lab10-V2（多頭下的空單版，需 Premium 才有 Footprint 模式）
// Base: V1（10空單策略下拉）
// V2 changes vs V1（20260713，依據 report_bull_short.html 出場×Gate掃描 750 組合）：
//   ① 新增 Regime Gate 下拉（多頭下空單的修正窗過濾）：無/4H MA20下方/DXY RSI≥55/
//      週VWAP下方/亞盤(07-16)/MA下方+DXY≥55（★掃描最佳）
//   ② 出場改為檔位下拉：短打16bars（SL0.8%/TP1.5/2R）★預設 / 短打8bars（SL0.8%/TP1/2R）/
//      原版自動檔位 / 手動
//   ③ 預設組合 = RS4頂部出貨FP + MA下方+DXY≥55 + 短打16：n=30 WR50% PF2.38（掃描榜首）
//
// 掃描結論（20260713，多頭下空單的配方）：
//   ① 假設「出場短打是解藥」被部分推翻：非FP觸發全組合 短打mean PF 1.14 vs 長抱 1.09，
//      中位數幾乎相同——出場結構只有邊際貢獻，救不了普通進場
//   ② 真正的答案：進場的「出貨證據」> 一切——RS4（POC高檔+delta負+收下半）霸榜前12名
//   ③ 普通觸發的活路 = DXY≥55 gate + 短打8bars：RS5假突破（n=49 PF1.75）、TS2破底（n=58 PF1.61）
//   ④ RS4 頻率-品質光譜：嚴格gate n=30/PF2.38 ↔ 無gate 8bars n=121/PF1.66
//   ⚠️ RS4 樣本全在 footprint 時代（2026/4起），無 IS 對照；匯出指標 V2（上緣失衡）可再強化
// Entry: LABS_SE（空單）
//@version=6
strategy(title="XAUUSD-Short-Lab10-V2",
 shorttitle="ShortLab10-V2",
 overlay = true,
 format=format.price,
 precision=2,
 default_qty_type=strategy.cash, initial_capital=10000,
 default_qty_value=10000, commission_value=0.00,
 slippage=1)

//------------------------------------------------------------------------------
// 1. 策略選擇與出場設定
//------------------------------------------------------------------------------
strategy.cancel_all()
MP = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

grp_sel = "=== 策略選擇（空單）==="
strat = input.string("RS4 逆勢空｜頂部出貨FP ★", "策略（全樣本0/10過門檻，★=OOS亮點）",
 options=["TS1 順勢空｜BBW擴張破位", "TS2 順勢空｜破底+Delta確認 ★OOS", "TS3 順勢空｜HTF動能空", "TS4 順勢空｜週VWAP失守", "TS5 順勢空｜DXY強勢順空 ★OOS", "RS1 逆勢空｜買方衰竭長上影 ✗", "RS2 逆勢空｜RSI超買+Delta轉弱 ✗", "RS3 逆勢空｜VWAP乖離過熱 ✗", "RS4 逆勢空｜頂部出貨FP ★", "RS5 逆勢空｜假突破反轉 ✗"],
 group=grp_sel,
 tooltip="順勢空（TS*）：確認賣方主導後跟進破位\n逆勢空（RS*）：在買方衰竭/出貨處摸頂（⚠️大多頭全滅，✗標記者PF<1）\n\n★RS4：POC高檔+delta負=高檔出貨，46筆PF2.32（僅footprint時代）\n★TS2/TS5：全樣本不行但OOS修正行情有效——等regime轉空再用\n\nPython 最佳化細節見 report_lab10_short.html")

is_trend = str.startswith(strat, "T")

grp_gate = "=== Regime Gate（多頭下空單的修正窗過濾，V2 新增）==="
gate_mode = input.string("MA下方+DXY≥55 ★", "Gate 模式",
 options=["無gate", "4H MA20下方", "DXY RSI≥55", "週VWAP下方", "亞盤(07-16)", "MA下方+DXY≥55 ★"],
 group=grp_gate,
 tooltip="多頭市場不是隨時能開空——只在「局部弱勢窗口」放行：\n\n4H MA20下方：短線結構已轉弱\nDXY RSI≥55：美元強勢壓制黃金（20260713掃描：普通觸發加此gate+短打後可過門檻）\n週VWAP下方：跌破機構本週成本線\n亞盤：多單數據顯示亞盤最弱（WR37.7%）→空單相對友善\nMA下方+DXY≥55：雙重確認（★掃描最佳：RS4+此gate+短打16 → n=30 WR50% PF2.38）")
gate_dxy_th = input.int(55, "Gate: DXY RSI 門檻", minval=45, maxval=70, group=grp_gate)

grp_exit = "=== 出場（V2 短打檔位，Profit Flyer 鏡像）==="
exit_mode = input.string("短打16（SL0.8%/TP1.5/2R/16bars）★", "出場檔位",
 options=["短打16（SL0.8%/TP1.5/2R/16bars）★", "短打8（SL0.8%/TP1/2R/8bars）", "自動（順勢空=S1檔/逆勢空=S2檔）", "手動（下方參數）"],
 group=grp_exit,
 tooltip="多頭下的下跌是急促短命的修正，空單要快進快出：\n短打16 = 持倉上限8小時（★RS4掃描最佳檔位）\n短打8 = 持倉上限4小時（普通觸發配DXY gate 的最佳檔位，頻率較高）\n自動 = V1 原版（多單檔位鏡像，長抱48bars——掃描證實只有邊際差異但RS4原版也能跑）\n\n⚠️ 20260713掃描：出場短打對「普通進場」只有邊際貢獻（mean PF 1.14 vs 1.09），真正的差異來自進場的出貨證據（RS4）")
sl_manual = input.float(1.0, "手動 SL %", step=0.1, group=grp_exit)
tp1_manual = input.float(2.0, "手動 TP1 R", step=0.1, group=grp_exit)
tp2_manual = input.float(4.0, "手動 TP2 R", step=0.1, group=grp_exit)
out_manual = input.int(48, "手動 時間出場（K棒）", group=grp_exit)

bool ex_s16 = exit_mode == "短打16（SL0.8%/TP1.5/2R/16bars）★"
bool ex_s8 = exit_mode == "短打8（SL0.8%/TP1/2R/8bars）"
bool ex_auto = exit_mode == "自動（順勢空=S1檔/逆勢空=S2檔）"
sl_pct = ex_s16 ? 0.8 : ex_s8 ? 0.8 : ex_auto ? (is_trend ? 0.5 : 1.0) : sl_manual
tp1_r = ex_s16 ? 1.5 : ex_s8 ? 1.0 : ex_auto ? (is_trend ? 1.0 : 2.0) : tp1_manual
tp2_r = ex_s16 ? 2.0 : ex_s8 ? 2.0 : ex_auto ? (is_trend ? 3.5 : 4.0) : tp2_manual
out_k = ex_s16 ? 16 : ex_s8 ? 8 : ex_auto ? (is_trend ? 36 : 48) : out_manual

//------------------------------------------------------------------------------
// 2. 各策略參數（預設值 = Python 最佳化結果）
//------------------------------------------------------------------------------
grp_ts1 = "=== TS1 BBW擴張破位（順勢空）==="
ts1_tf = input.timeframe("60", "TS1: BBW 時框", group=grp_ts1)
ts1_ranklen = input.int(60, "TS1: BBW rank 回看", minval=20, group=grp_ts1)
ts1_thr = input.float(80.0, "TS1: 點火門檻 %", step=5.0, group=grp_ts1, tooltip="最佳化：80（PF1.05/OOS0.98 未達門檻）——多單版T4是順勢最佳，空單鏡像在多頭市場失效")

grp_ts2 = "=== TS2 破底+Delta確認（順勢空 ★OOS）==="
ts2_n = input.int(96, "TS2: 破底回看K棒數", minval=8, group=grp_ts2, tooltip="close < 前N根最低點。最佳化：96")
ts2_dmin = input.float(20.0, "TS2: Delta負佔比下限 %（0=不用）", step=5.0, group=grp_ts2, tooltip="footprint delta ≤ −此值 才進場（na放行）。最佳化：20\n★全樣本PF0.99但OOS PF1.58——修正行情中「賣方主導的破底」有效，多單版delta沒加分、空單版有")

grp_ts3 = "=== TS3 HTF動能空（順勢空）==="
ts3_lvl = input.int(45, "TS3: RSI 下穿門檻", minval=30, maxval=60, group=grp_ts3, tooltip="最佳化：45（OOS1.15）")
ts3_tf = input.timeframe("240", "TS3: 結構 MA 時框", group=grp_ts3)
ts3_malen = input.int(10, "TS3: 結構 MA 週期", minval=5, group=grp_ts3)

grp_ts4 = "=== TS4 週VWAP失守（順勢空）==="
// 無參數（前根收上方、本根黑K收破）——最佳化結果 PF0.86 未達門檻

grp_ts5 = "=== TS5 DXY強勢順空（順勢空 ★OOS）==="
ts5_dxy = input.int(60, "TS5: DXY RSI 門檻（≥ 此值）", minval=45, maxval=75, group=grp_ts5, tooltip="美元強勢+金價在4H MA20下方+黑K。最佳化：60（OOS PF1.42 n=135）")
ts5_dxysym = input.symbol("TVC:DXY", "TS5: DXY 代碼", group=grp_ts5)

grp_rs1 = "=== RS1 買方衰竭長上影（逆勢空 ✗）==="
rs1_ws = input.float(0.6, "RS1: 上影線佔比下限", step=0.1, minval=0.3, group=grp_rs1, tooltip="✗ PF0.66——多單版R2是逆勢最佳，鏡像到空單在多頭市場完全失效（上影線在多頭是吸籌不是出貨）")
rs1_m = input.float(1.5, "RS1: 爆量倍數", step=0.25, minval=1.0, group=grp_rs1)
rs1_vlen = input.int(20, "RS1: 均量週期", minval=5, group=grp_rs1)

grp_rs2 = "=== RS2 RSI超買+Delta轉弱（逆勢空 ✗）==="
rs2_th = input.int(70, "RS2: RSI 超買門檻", minval=60, maxval=85, group=grp_rs2, tooltip="✗ PF0.54 全Lab最差——大多頭裡RSI超買是趨勢強度不是反轉訊號")
rs2_det = input.float(0.0, "RS2: Delta惡化下限 pp（0=不用）", step=1.0, group=grp_rs2)

grp_rs3 = "=== RS3 VWAP乖離過熱（逆勢空 ✗）==="
rs3_d = input.float(3.0, "RS3: 乖離門檻（×ATR14）", step=0.5, group=grp_rs3, tooltip="✗ PF0.70——與多單R3同課題：沒有出貨證據的乖離摸頂=接火箭")

grp_rs4 = "=== RS4 頂部出貨FP（逆勢空 ★預設）==="
rs4_poc = input.float(65.0, "RS4: POC 位置下限 %", step=5.0, group=grp_rs4, tooltip="POC在K棒高檔=大量成交發生在高處。最佳化：65")
rs4_dneg = input.float(5.0, "RS4: Delta 負佔比下限 %", step=1.0, group=grp_rs4, tooltip="delta ≤ −此值：高檔大量成交且賣方勝出=出貨(distribution)，再加收在下半\n★46筆 WR47.8% PF2.32（全部在footprint時代2026/4+，無IS對照）——空單最強素材，也可反向當多單出場警示")

grp_rs5 = "=== RS5 假突破反轉（逆勢空 ✗）==="
rs5_fb = input.float(0.2, "RS5: 收回前高下方 %", step=0.1, group=grp_rs5, tooltip="盤中創48根新高但收回前高−此%以下。✗ PF0.87")

grp_fp = "=== Footprint 共用（TS2/RS2/RS4 使用，Premium）==="
fp_ticks_per_row = input.int(250, "每列 tick 數", minval=1, group=grp_fp)
fp_va_percent = input.int(70, "Value Area %", minval=50, maxval=95, group=grp_fp)
fp_imbalance_pct = input.int(300, "失衡判定門檻 %", minval=100, group=grp_fp)

grp_disp = "=== 顯示 ==="
show_sig_all = input.bool(true, "標示被持倉擋掉的訊號（灰色）", group=grp_disp)

//------------------------------------------------------------------------------
// 3. 指標運算
//------------------------------------------------------------------------------
rsi14 = ta.rsi(close, 14)
atr14 = ta.atr(14)
ohlc4_basis = ta.sma(ohlc4, 20)
wvwap = ta.vwap(hlc3, timeframe.change("1W"))
vol_sma = ta.sma(volume, rs1_vlen)

ts1_rank = request.security(syminfo.tickerid, ts1_tf, ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), ts1_ranklen), lookahead=barmerge.lookahead_off)
ts3_ma = request.security(syminfo.tickerid, ts3_tf, ta.sma(close, ts3_malen), lookahead=barmerge.lookahead_off)
ts5_ma240 = request.security(syminfo.tickerid, "240", ta.sma(close, 20), lookahead=barmerge.lookahead_off)
dxy_rsi_d = request.security(ts5_dxysym, "D", ta.rsi(close, 14), lookahead=barmerge.lookahead_off)

// Regime Gate（V2）
t_asia = time(timeframe.period, "0700-1600", "Asia/Taipei")
bool is_asia = not na(t_asia)
bool gate_ok = true
if gate_mode == "4H MA20下方"
    gate_ok := close < ts5_ma240
else if gate_mode == "DXY RSI≥55"
    gate_ok := dxy_rsi_d >= gate_dxy_th
else if gate_mode == "週VWAP下方"
    gate_ok := close < wvwap
else if gate_mode == "亞盤(07-16)"
    gate_ok := is_asia
else if gate_mode == "MA下方+DXY≥55 ★"
    gate_ok := close < ts5_ma240 and dxy_rsi_d >= gate_dxy_th

// Footprint（單次呼叫）
footprint fp = request.footprint(fp_ticks_per_row, fp_va_percent, fp_imbalance_pct)
bool fp_data_ok = not na(fp)
float fp_delta_ratio = na
float fp_poc_pos = na
if fp_data_ok
    float buyV = fp.buy_volume()
    float sellV = fp.sell_volume()
    float totV = buyV + sellV
    fp_delta_ratio := totV > 0 ? (buyV - sellV) / totV * 100 : 0.0
    volume_row pocRow = fp.poc()
    float poc_mid = (pocRow.up_price() + pocRow.down_price()) / 2
    fp_poc_pos := high == low ? 50.0 : (poc_mid - low) / (high - low) * 100

var array<float> dr_hist = array.new_float()
float dr_prior_avg = na
if fp_data_ok
    if array.size(dr_hist) > 0
        dr_prior_avg := array.avg(dr_hist)
    array.push(dr_hist, fp_delta_ratio)
    if array.size(dr_hist) > 5
        array.shift(dr_hist)

// K線特徵
bar_range = high - low
body_top = math.max(open, close)
upper_wick_ratio = bar_range > 0 ? (high - body_top) / bar_range : 0.0
is_black = close < open

//------------------------------------------------------------------------------
// 4. 各策略訊號（空單）
//------------------------------------------------------------------------------
// TS1 BBW擴張破位
ts1_ignite = ts1_rank >= ts1_thr and ts1_rank[1] < ts1_thr
sig_ts1 = ts1_ignite and is_black and close < ohlc4_basis

// TS2 破底+Delta（delta na→放行）
ts2_ll = ta.lowest(low, ts2_n)[1]
ts2_delta_ok = ts2_dmin <= 0 or (not fp_data_ok ? true : fp_delta_ratio <= -ts2_dmin)
sig_ts2 = close < ts2_ll and ts2_delta_ok

// TS3 HTF動能空
ts3_cross_dn = rsi14 < ts3_lvl and rsi14[1] >= ts3_lvl
sig_ts3 = ts3_cross_dn and close < ts3_ma

// TS4 週VWAP失守
sig_ts4 = close[1] > wvwap[1] and close < wvwap and is_black

// TS5 DXY強勢順空
sig_ts5 = dxy_rsi_d >= ts5_dxy and close < ts5_ma240 and is_black

// RS1 買方衰竭長上影
sig_rs1 = upper_wick_ratio >= rs1_ws and volume >= vol_sma * rs1_m

// RS2 RSI超買+Delta轉弱（delta na→放行）
rs2_delta_ok = rs2_det <= 0 or (not fp_data_ok ? true : (not na(dr_prior_avg) and dr_prior_avg - fp_delta_ratio >= rs2_det))
sig_rs2 = rsi14 > rs2_th and is_black and rs2_delta_ok

// RS3 VWAP乖離過熱
sig_rs3 = (close - wvwap) / atr14 >= rs3_d and is_black

// RS4 頂部出貨（FP核心，na→無訊號）
sig_rs4 = fp_data_ok and fp_poc_pos >= rs4_poc and fp_delta_ratio <= -rs4_dneg and close < (high + low) / 2

// RS5 假突破反轉
rs5_hh = ta.highest(high, 48)[1]
sig_rs5 = high > rs5_hh and close < rs5_hh * (1 - rs5_fb / 100) and is_black

// 選擇
bool raw_sig = false
if strat == "TS1 順勢空｜BBW擴張破位"
    raw_sig := sig_ts1
else if strat == "TS2 順勢空｜破底+Delta確認 ★OOS"
    raw_sig := sig_ts2
else if strat == "TS3 順勢空｜HTF動能空"
    raw_sig := sig_ts3
else if strat == "TS4 順勢空｜週VWAP失守"
    raw_sig := sig_ts4
else if strat == "TS5 順勢空｜DXY強勢順空 ★OOS"
    raw_sig := sig_ts5
else if strat == "RS1 逆勢空｜買方衰竭長上影 ✗"
    raw_sig := sig_rs1
else if strat == "RS2 逆勢空｜RSI超買+Delta轉弱 ✗"
    raw_sig := sig_rs2
else if strat == "RS3 逆勢空｜VWAP乖離過熱 ✗"
    raw_sig := sig_rs3
else if strat == "RS4 逆勢空｜頂部出貨FP ★"
    raw_sig := sig_rs4
else if strat == "RS5 逆勢空｜假突破反轉 ✗"
    raw_sig := sig_rs5

//------------------------------------------------------------------------------
// 5. 進出場（Profit Flyer 鏡像，空單）
//------------------------------------------------------------------------------
MaxUseBars = 100
ShortEntry = bar_index > MaxUseBars and MP == 0 and raw_sig and gate_ok

if ShortEntry
    strategy.entry("LABS_SE", strategy.short, comment="LABS_SE")

EntryPrice = strategy.opentrades.entry_price(strategy.opentrades - 1)
BarsSinceEntry = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)

SLPrice = EntryPrice * (1 + sl_pct / 100)
PTPrice1 = EntryPrice * (1 - sl_pct / 100 * tp1_r)
PTPrice2 = EntryPrice * (1 - sl_pct / 100 * tp2_r)

var float exit_stop_price = na

if MP < 0
    if close <= PTPrice2
        exit_stop_price := math.min(PTPrice2, ta.highest(high, math.max(out_k / 4, 1)))
        strategy.exit("LABS_TP2", from_entry="LABS_SE", stop=exit_stop_price, comment="LABS_TP2")
    else if close <= PTPrice1
        exit_stop_price := math.min(PTPrice1, ta.highest(high, math.max(out_k / 2, 1)))
        strategy.exit("LABS_TP1", from_entry="LABS_SE", stop=exit_stop_price, comment="LABS_TP1")
    else
        strategy.exit("LABS_SL", from_entry="LABS_SE", stop=SLPrice, comment_loss="LABS_SL")
    if BarsSinceEntry >= out_k
        if strategy.openprofit >= 0
            exit_stop_price := math.min(SLPrice, ta.highest(high, out_k))
            strategy.exit("LABS_TimeWin", from_entry="LABS_SE", stop=exit_stop_price, comment="LABS_TimeWin")
        else
            exit_stop_price := high
            strategy.exit("LABS_TimeLoss", from_entry="LABS_SE", stop=exit_stop_price, comment="LABS_TimeLoss")

alertcondition(ShortEntry, title="ShortLab10 Entry", message="ShortLab10 Signal, Price={{close}}")

//------------------------------------------------------------------------------
// 6. 視覺化
//------------------------------------------------------------------------------
plot(strat == "TS4 順勢空｜週VWAP失守" or strat == "RS3 逆勢空｜VWAP乖離過熱 ✗" ? wvwap : na, title="Weekly VWAP", color=color.new(color.orange, 0), linewidth=2)
plot(strat == "TS3 順勢空｜HTF動能空" ? ts3_ma : na, title="TS3 HTF MA", color=color.new(color.purple, 0), linewidth=1)

plotshape(ShortEntry, title="ShortLab Entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="LABS")
plotshape(show_sig_all and raw_sig and not ShortEntry and MP != 0, title="Signal (In Position)", style=shape.triangledown, location=location.abovebar, color=color.new(color.gray, 60), size=size.tiny, text="·")

if strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    yPos = low * 0.998
    txt = "SE: " + str.tostring(EntryPrice, "#.##") + "\nSL: " + str.tostring(SLPrice, "#.##") + "\nTP1: " + str.tostring(PTPrice1, "#.##") + "\nTP2: " + str.tostring(PTPrice2, "#.##")
    label.new(bar_index, yPos, text=txt, style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
