// © Tittan
// 診斷用腳本 — 非正式版本序列的一部分，不要拿來替換 V3.7 或 V3.8.1
// 目的：拆解 V3.4→V3.7 真實績效改善，到底來自哪一個入場端改動
//
// 20260710 發現：ANALYSIS_SKILL.md / report_v3.7_real.html 原本記載「V3.4 TP2為2:1，
// V3.7拉長到3.5R」是錯的——直接查兩版真實成交CSV，TP1/TP2/SL 中位數（0.5%/1.75%/-0.5%）
// 兩版完全相同，出場結構從未改變過。真正的差異是兩個入場端改動被混在一起：
//   改動①：1H MA 濾網從 lookahead_on（V3.4，會偷看未來資料的 repainting bug）
//          修正為 lookahead_off（V3.7，乾淨無偷看）
//   改動②：新增 BBW 高檔 Regime 過濾器（V3.4 沒有，V3.7 有，預設 ON @70% / 60根）
// 本腳本用兩個開關獨立控制這兩項改動，2×2 共 4 種組合，在 TradingView Strategy
// Tester 分別切換、各自 Export List of Trades，即可精確拆解各自貢獻。
//
// 對照組合（在下方 Inputs 面板切換）：
//   A（=V3.4）：test_lookahead_bug=ON，  test_bbw_filter=OFF
//   B（純修bug）：test_lookahead_bug=OFF， test_bbw_filter=OFF
//   C（純加過濾）：test_lookahead_bug=ON，  test_bbw_filter=ON
//   D（=V3.7）：test_lookahead_bug=OFF， test_bbw_filter=ON
// 時間出場固定 48 根（V3.4 原始值，此參數已由 report_v3.7_real.html 證實從未觸發、
// 對績效無影響，四組全部固定同一值，不需要納入這次的 2×2）。
// TP1=1.0R / TP2=3.5R / SL=0.5% 固定（兩版真實資料證實這三者從未改變）。
//
// 用法：四種組合各跑一次 Strategy Tester → Export List of Trades → 檔名附上 A/B/C/D
// 字樣，回傳給 Claude 後可用既有 loader.py / fail_patterns.py / metrics.py 分析。
//@version=6
strategy(title="S1-AweWithBB V3.7 ABCD 診斷（非正式版本）",
 shorttitle="S1-ABCD-Diag",
 overlay = true,
 format=format.price,
 precision=2,
 default_qty_type=strategy.cash, initial_capital=10000,
 default_qty_value=10000, commission_value=0.00,
 slippage=1)

//------------------------------------------------------------------------------
// 1. 輸入 (Inputs)
//------------------------------------------------------------------------------
strategy.cancel_all()
MP = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

grp_abcd = "=== ★★★ A/B/C/D 對照開關（本次診斷核心） ==="
test_lookahead_bug = input.bool(true, "1H濾網用lookahead_on（V3.4原始bug，勾選=有bug）", group=grp_abcd,
 tooltip="打勾 = 複製 V3.4 的 lookahead_on 設定（會偷看未來高時框資料）\n不打勾 = V3.7 修正後的 lookahead_off（乾淨無偷看）")
test_bbw_filter = input.bool(false, "啟用 BBW 高檔過濾器（V3.7新增，勾選=有此過濾器）", group=grp_abcd,
 tooltip="打勾 = 複製 V3.7 新增的 BBW 高檔 Regime 過濾器\n不打勾 = V3.4 原始狀態（沒有這個過濾器）")

grp_risk = "=== 風險與出場（四組全部固定，兩版真實資料證實從未改變） ==="
SL_Pct         = input.float(0.5, "固定止損 %",     step=0.1, group=grp_risk)
Profit_Ratio_1 = input.float(1.0, "TP1 盈虧比",     step=0.1, group=grp_risk)
Profit_Ratio_2 = input.float(3.5, "TP2 盈虧比",     step=0.1, group=grp_risk)
out_k_count    = input.int(48,    "時間出場（K棒，固定用V3.4原始值48）", group=grp_risk)

grp_ind = "=== S1 核心指標（兩版相同）==="
bb_length   = input.int(20,   minval=1, title="BB Length",       group=grp_ind)
bb_mult     = input.float(2.0, title="BB Multiplier",            group=grp_ind)
bb_source   = input(close,    title="BB Source",                 group=grp_ind)
fast_ma_len = input.int(3,    minval=2, title="Fast EMA Length", group=grp_ind)
ao_slow_len = input.int(34,   minval=1, title="AO Slow Length",  group=grp_ind)
ao_fast_len = input.int(5,    minval=1, title="AO Fast Length",  group=grp_ind)

grp_filter = "=== 1H MA 過濾器（兩版皆啟用，差異只在 lookahead）==="
ma1h_length = input.int(3, minval=1, title="1H MA Length",   group=grp_filter)

grp_bbw = "=== BBW 高檔過濾器（僅 test_bbw_filter=ON 時生效）==="
bbw_high_tf     = input.timeframe("60", "BBW 高檔時框", group=grp_bbw)
bbw_high_lb     = input.int(60, "BBW高檔回看K棒數", group=grp_bbw)
regime_bbw_high = input.float(70.0, "趨勢帶 BBW rank 門檻（%）", step=5.0, group=grp_bbw)

//------------------------------------------------------------------------------
// 2. 指標運算 (Indicators)
//------------------------------------------------------------------------------
bb_basis = ta.sma(bb_source, bb_length)
bb_dev   = ta.stdev(bb_source, bb_length) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

fast_ma    = ta.ema(bb_source, fast_ma_len)
xSMA1_hl2  = ta.sma(hl2, ao_fast_len)
xSMA2_hl2  = ta.sma(hl2, ao_slow_len)
AO_Val     = xSMA1_hl2 - xSMA2_hl2
AO_State   = AO_Val >= 0 ? (AO_Val > AO_Val[1] ? 1 : 2) : (AO_Val > AO_Val[1] ? -1 : -2)

// ── 改動①：1H MA，兩種 lookahead 都算，依開關選用 ──
ma1h_leaky = request.security(syminfo.tickerid, "60", ta.sma(close, ma1h_length), lookahead=barmerge.lookahead_on)
ma1h_clean = request.security(syminfo.tickerid, "60", ta.sma(close, ma1h_length), lookahead=barmerge.lookahead_off)
ma1h = test_lookahead_bug ? ma1h_leaky : ma1h_clean
filter_1h_ok = close > ma1h

// ── 改動②：BBW 高檔過濾器，依開關決定是否套用 ──
bbw_rank_high = request.security(syminfo.tickerid, bbw_high_tf,
 ta.percentrank(ta.stdev(close, 20) * 4 / ta.sma(close, 20), bbw_high_lb),
 lookahead=barmerge.lookahead_off)
is_bbw_high  = bbw_rank_high >= regime_bbw_high
bbw_high_ok  = not test_bbw_filter or not is_bbw_high

//------------------------------------------------------------------------------
// 3. 進場邏輯 (Entry)
//------------------------------------------------------------------------------
MaxUseBars = 1 + math.max(bb_length, 1)
var LongEntry = false

LongCondition = ta.crossover(fast_ma, bb_basis) and
 close > bb_basis and math.abs(AO_State) == 1 and
 filter_1h_ok and bbw_high_ok

LongEntry := bar_index > MaxUseBars and MP == 0 and LongCondition

variant_tag = (test_lookahead_bug ? "A/C(leaky)" : "B/D(clean)") + "_" + (test_bbw_filter ? "BBWon" : "BBWoff")

if LongEntry
    strategy.entry("S1BB_LE", strategy.long, comment="ABCD_" + variant_tag)

//------------------------------------------------------------------------------
// 4. 出場邏輯 (Exit) — 四組完全相同，H2 分級追蹤停損
//------------------------------------------------------------------------------
EntryPrice     = strategy.opentrades.entry_price(strategy.opentrades - 1)
BarsSinceEntry = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
SLPrice        = EntryPrice * (1 - SL_Pct / 100)
PTPrice1       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_1)
PTPrice2       = EntryPrice * (1 + SL_Pct / 100 * Profit_Ratio_2)

var float exit_stop_price = na

if MP > 0
    if close >= PTPrice2
        exit_stop_price := math.max(PTPrice2, ta.lowest(low, out_k_count / 4))
        strategy.exit("S1BB_TP2", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP2")
    else if close >= PTPrice1
        exit_stop_price := math.max(PTPrice1, ta.lowest(low, out_k_count / 2))
        strategy.exit("S1BB_TP1", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TP1")
    else
        strategy.exit("S1BB_SL", from_entry="S1BB_LE", stop=SLPrice, comment_loss="S1BB_SL")
    if BarsSinceEntry >= out_k_count
        if strategy.openprofit >= 0
            exit_stop_price := math.max(SLPrice, ta.lowest(low, out_k_count))
            strategy.exit("S1BB_TimeWin",  from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeWin")
        else
            exit_stop_price := low
            strategy.exit("S1BB_TimeLoss", from_entry="S1BB_LE", stop=exit_stop_price, comment="S1BB_TimeLoss")

alertcondition(LongEntry, title="S1BB Entry", message="S1BB ABCD Diagnostic Entry, Price={{close}}")

//------------------------------------------------------------------------------
// 5. 視覺化 (Visualization)
//------------------------------------------------------------------------------
plot(bb_basis, "Basis", color.new(color.red,   0), 2)
p1 = plot(bb_upper, "Upper", color.new(color.blue, 0))
p2 = plot(bb_lower, "Lower", color.new(color.blue, 0))
fill(p1, p2, color.new(color.silver, 90))
plot(fast_ma,   "Fast EMA",  color.new(color.black,  0))

bgcolor(test_bbw_filter and is_bbw_high ? color.new(color.red, 90) : na, title="BBW High Block")

var table info = table.new(position.top_right, 2, 3, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    current_variant = (test_lookahead_bug and not test_bbw_filter) ? "A（=V3.4）" :
                       (not test_lookahead_bug and not test_bbw_filter) ? "B（純修bug）" :
                       (test_lookahead_bug and test_bbw_filter) ? "C（純加過濾）" : "D（=V3.7）"
    table.cell(info, 0, 0, "目前組合", bgcolor=color.gray, text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, current_variant, bgcolor=color.new(color.teal,60), text_color=color.white, text_size=size.small)
    table.cell(info, 0, 1, "1H濾網", bgcolor=color.new(color.gray,80), text_color=color.black, text_size=size.small)
    table.cell(info, 1, 1, test_lookahead_bug ? "lookahead_ON(V3.4)" : "lookahead_OFF(V3.7)", text_color=color.black, text_size=size.small)
    table.cell(info, 0, 2, "BBW高檔過濾", bgcolor=color.new(color.gray,80), text_color=color.black, text_size=size.small)
    table.cell(info, 1, 2, test_bbw_filter ? "ON(V3.7)" : "OFF(V3.4)", text_color=color.black, text_size=size.small)

if strategy.opentrades > 0 and strategy.opentrades.entry_bar_index(0) == bar_index
    yPos = high * 1.002
    txt = "S1BB_LE [" + variant_tag + "]\n" + str.tostring(EntryPrice, "#.##") +
          "\nSL: "  + str.tostring(SLPrice,   "#.##") +
          "\nTP1: " + str.tostring(PTPrice1,  "#.##") +
          "\nTP2: " + str.tostring(PTPrice2,  "#.##")
    label.new(bar_index, yPos, txt, style=label.style_label_down,
     color=color.new(color.teal,0), textcolor=color.white, size=size.small)
